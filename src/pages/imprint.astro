---
// Imprint (§ 5 DDG) of RuW Lifestyle GmbH in English, a convenience translation of the German
// Impressum (src/pages/de/impressum.astro), which is the legally binding version.
// Legal facts come from src/config/site.ts.
import ArticleLayout from '../layouts/ArticleLayout.astro';
import { site, company, contact, credentials, contentUpdated, type NavItem } from '../config/site';
import { ids, ref } from '../lib/schema';
import { url } from '../lib/url';
import { t } from '../i18n';

const title = `Imprint | ${site.name}`;
const description = `Imprint of ${site.domain}: ${company.name}, ${company.street}, ${contact.postalCode} ${contact.city}, Germany, represented by ${company.managingDirector}.`;
const breadcrumbs: NavItem[] = [{ label: 'Imprint', href: '/imprint/' }];
---

<ArticleLayout
  title={title}
  description={description}
  heading="Imprint"
  lead={`The provider of this website is ${company.name} in ${contact.city}, Germany.`}
  label="Legal"
  breadcrumbs={breadcrumbs}
  updated={contentUpdated}
  page={{ about: ref(ids(Astro.site).company) }}
>
  <p>
    This English text is a convenience translation. The legally binding version is the German
    <a href={url('/de/impressum/')} hreflang="de">Impressum</a>.
  </p>

  <h2>Information pursuant to § 5 of the German Digital Services Act (Digitale-Dienste-Gesetz, DDG)</h2>
  <p>
    {company.name}<br />
    {company.street}<br />
    {contact.postalCode} {contact.city}<br />
    {t('en').site.country}
  </p>
  <p>
    Represented by the managing director (Geschäftsführer):<br />
    {company.managingDirector}
  </p>

  <h2>Contact</h2>
  <p>
    Telephone: <a href={contact.phone.href}>{contact.phone.display}</a><br />
    Email: <a class="break-all" href={contact.email.href}>{contact.email.display}</a><br />
    Website: {company.website}
  </p>

  <h2>Commercial register (Handelsregister)</h2>
  <p>
    Register court (Amtsgericht, local court): {company.registerCourt}<br />
    Registration number: {company.registerNumber}
  </p>

  <h2>VAT identification number</h2>
  <p>
    VAT identification number (Umsatzsteuer-Identifikationsnummer, USt-IdNr.) pursuant to § 27a of the German VAT
    Act (Umsatzsteuergesetz):<br />
    {company.vatId}
  </p>

  <h2>Professional information</h2>
  <p>
    {site.expert}<br />
    Examined and certified expert of the Deutscher Gutachter und Sachverständigen Verband
    ({credentials.associationShort}, German association of experts and assessors)
  </p>
  <p>Expert work in the field of tattoos and piercings.</p>
  <p>More than {credentials.yearsInTrade} years of practical professional experience in tattooing and piercing.</p>
  <p>Member of the {credentials.membership} (German federal tattoo association).</p>
  <p>{site.expert} was appointed as expert witness by the {t('en').court} in court proceedings.</p>
  <p>
    An appointment by the court in a single case is not a public appointment and swearing in as an expert (öffentliche
    Bestellung und Vereidigung).
  </p>

  <h2>Consumer dispute resolution pursuant to § 36 VSBG</h2>
  <p>
    {company.name} is neither obliged nor willing to take part in dispute resolution proceedings before a consumer
    arbitration board (Verbraucherschlichtungsstelle) under the German Consumer Dispute Resolution Act
    (Verbraucherstreitbeilegungsgesetz, VSBG).
  </p>

  <h2>Responsibility for content</h2>
  <p>
    As service provider, {company.name} is responsible for its own content on this website under the general
    statutory provisions.
  </p>
  <p>
    For third-party content referred to through external links, the statutory provisions apply. Any liability is
    governed by the applicable statutory provisions.
  </p>

  <h2>Copyright</h2>
  <p>
    The texts, photographs, graphics and other content published on this website are subject to German copyright law,
    insofar as they are protected by copyright.
  </p>
  <p>
    Any reproduction, adaptation, distribution or other use beyond the statutory limits of copyright requires the
    consent of the respective rights holder.
  </p>
  <p>Where third-party content is used, the rights of those third parties are respected.</p>

  <div slot="aside" class="grid gap-8">
    <div>
      <p class="label text-ink">Provider</p>
      <p class="mt-3 font-serif text-h4 text-ink">{company.name}</p>
      <p class="mt-2">
        {company.street}, {contact.postalCode} {contact.city}, Germany. Represented by the managing director
        {company.managingDirector}.
      </p>
    </div>
    <div class="border-t border-rule pt-5">
      <p class="label text-ink">Privacy</p>
      <p class="mt-3">
        Which data is processed when you visit these pages and book an appointment is set out in the
        <a class="link-ink font-semibold" href={url('/privacy/')}>privacy policy</a>.
      </p>
    </div>
  </div>
</ArticleLayout>
