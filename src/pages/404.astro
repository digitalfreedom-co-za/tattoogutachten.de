---
// Not found page (GitHub Pages serves dist/404.html for every unknown path, in both locales). Never
// indexed, no canonical and no JSON-LD. Bilingual: the English block first (the page renders in the
// default locale), then a German block with lang="de", each leading to home, services and booking of
// its locale.
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Button from '../components/ui/Button.astro';
import ServiceList from '../components/ui/ServiceList.astro';
import { site, contact, mainNavFor } from '../config/site';
import { servicesFor } from '../data';
import { routes } from '../i18n';
import { url } from '../lib/url';

const mainNav = mainNavFor('en');
---

<BaseLayout
  title={`Page not found | ${site.name}`}
  description={`This page does not exist or no longer exists. From here you can go to the services, the process and the contact details of ${site.office}.`}
  noindex
>
  <section aria-labelledby="error-title">
    <Container class="grid gap-12 pt-12 pb-section md:grid-cols-12 md:gap-x-8 md:pt-20">
      <div class="md:col-span-3">
        <div class="hairline mb-4" aria-hidden="true"></div>
        <Eyebrow>Page not found</Eyebrow>
      </div>
      <div class="md:col-span-9 lg:col-span-8">
        <h1 id="error-title" class="text-h1 tracking-display">This page does not exist here.</h1>
        <p class="mt-6 max-w-[38rem] text-lead text-graphite">
          The link is out of date or the address was mistyped. Everything on expert reports about tattoos and piercings
          can be reached from the home page or directly from the sections below.
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-5">
          <Button href={routes.home.en}>Go to the home page</Button>
          <Button href={routes.booking.en} variant="secondary" icon="calendar">Book a consultation</Button>
        </div>

        <nav aria-label="Sections of the website" class="mt-16 border-t border-ink pt-5">
          <p class="label text-ink">Sections</p>
          <ul class="mt-2 grid gap-x-8 sm:grid-cols-2">
            {
              mainNav.map((item) => (
                <li>
                  <a class="link-ink inline-flex min-h-11 items-center font-semibold" href={url(item.href)}>{item.label}</a>
                </li>
              ))
            }
          </ul>
        </nav>

        <h2 class="mt-16 text-h3">Expert reports at a glance</h2>
        <ServiceList services={servicesFor('en')} class="mt-6" />

        <p class="mt-12 text-graphite">
          Prefer to ask directly? You can reach {site.expert} on
          <a class="link-ink font-semibold" href={contact.phone.href}>{contact.phone.display}</a>
          or by email at <a class="link-ink font-semibold break-all" href={contact.email.href}>{contact.email.display}</a>.
        </p>

        <div lang="de" class="mt-16 border-t border-ink pt-8">
          <h2 class="text-h3">Diese Seite gibt es hier nicht.</h2>
          <p class="mt-4 max-w-[38rem] text-graphite">
            Der Link ist veraltet oder die Adresse wurde falsch eingegeben. Alle Inhalte auf Deutsch erreichen Sie über
            die deutsche Startseite.
          </p>
          <ul class="mt-4 flex flex-wrap gap-x-8">
            <li><a class="link-ink inline-flex min-h-11 items-center font-semibold" href={url(routes.home.de)}>Zur Startseite</a></li>
            <li><a class="link-ink inline-flex min-h-11 items-center font-semibold" href={url(routes.services.de)}>Leistungen</a></li>
            <li><a class="link-ink inline-flex min-h-11 items-center font-semibold" href={url(routes.booking.de)}>Termin buchen</a></li>
          </ul>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
