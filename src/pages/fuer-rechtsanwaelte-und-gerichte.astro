---
// Former combined page for lawyers and courts, split into /fuer-rechtsanwaelte/ and /fuer-gerichte/.
// GitHub Pages has no server redirects: this stub forwards old links and bookmarks, is never indexed
// and stays out of the sitemap (astro.config.mjs).
import { url } from '../lib/url';

const target = url('/fuer-rechtsanwaelte/');
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={new URL(target, Astro.site).href} />
    <title>Seite umgezogen</title>
  </head>
  <body>
    <p>
      Diese Seite ist umgezogen: <a href={target}>für Rechtsanwälte</a> und
      <a href={url('/fuer-gerichte/')}>für Gerichte</a>.
    </p>
  </body>
</html>
