---
// One page per audience (/fuer-privatpersonen/, /fuer-tattoo-studios/, /fuer-rechtsanwaelte/, /fuer-gerichte/),
// generated from src/data/audiences.ts: first steps where the audience needs them, situation, how the
// expert helps, fitting services, what to prepare, typical questions, Ratgeber articles and the CTA.
// Private clients and studios are led to the free first consultation; lawyers and courts (primaryAction
// enquiry) to telephone and email, with the preparation block moved up next to the help block.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import ExpertCard from '../components/ui/ExpertCard.astro';
import ServiceList from '../components/ui/ServiceList.astro';
import ArticleList from '../components/ui/ArticleList.astro';
import CourtReference from '../components/ui/CourtReference.astro';
import CompareTable from '../components/ui/CompareTable.astro';
import Faq from '../components/ui/Faq.astro';
import ArtImage from '../components/ui/ArtImage.astro';
import CtaBand from '../components/ui/CtaBand.astro';
import AudiencePrepare from '../components/audience/AudiencePrepare.astro';
import { site, contact, contentUpdated, primaryCta } from '../config/site';
import { url } from '../lib/url';
import { audiences, audienceHref, type Audience, type AudienceSlug } from '../data/audiences';
import { serviceBySlug, reportComparison } from '../data/services';
import { faqForAudience } from '../data/faq';
import { getArticles, articlesForAudience } from '../lib/ratgeber';
import { ref, serviceId } from '../lib/schema';
import type { ImageMetadata } from 'astro';

import atWork from '../assets/images/patrick-wolf-beim-taetowieren.webp';
import studio from '../assets/images/patrick-wolf-studio-weit.webp';
import portrait from '../assets/images/patrick-wolf-portrait-studio-sitzend.jpg';

export function getStaticPaths() {
  return audiences.map((audience) => ({ params: { audience: audience.slug }, props: { audience } }));
}

interface Props {
  audience: Audience;
}

const { audience } = Astro.props;
const services = audience.services.map(serviceBySlug);
const questions = faqForAudience(audience.slug);
const articles = articlesForAudience(await getArticles(), audience.slug);
const breadcrumbs = [{ label: `Für ${audience.label}`, href: audienceHref(audience) }];

const pictures: Record<AudienceSlug, { src: ImageMetadata; alt: string }> = {
  'fuer-privatpersonen': {
    src: atWork,
    alt: `${site.expert} mit Handschuhen bei konzentrierter Arbeit an einer Tätowierung.`,
  },
  'fuer-tattoo-studios': {
    src: studio,
    alt: `${site.expert} sitzt lächelnd in seinem Studio in ${contact.city} zwischen den Behandlungsliegen.`,
  },
  'fuer-rechtsanwaelte': {
    src: portrait,
    alt: `${site.expert}, Sachverständiger für Tätowierungen und Piercings, sitzt im Studio und hört aufmerksam zu.`,
  },
  'fuer-gerichte': {
    src: portrait,
    alt: `${site.expert}, Sachverständiger für Tätowierungen und Piercings, sitzt im Studio und hört aufmerksam zu.`,
  },
};
const picture = pictures[audience.slug];
const enquiry = audience.primaryAction === 'enquiry';

// Tones follow the purpose of a block, not its position: narrative on paper, working material
// (first steps, preparation, court appointment and comparison) on deep paper.

const page = {
  audience: { '@type': 'Audience', audienceType: audience.label },
  mentions: services.map((service) => ref(serviceId(service, Astro.site))),
};
---

<BaseLayout title={audience.metaTitle} description={audience.metaDescription} breadcrumbs={breadcrumbs} page={page}>
  <PageHeader
    label={`Für ${audience.label}`}
    heading={audience.heading}
    lead={audience.lead}
    breadcrumbs={breadcrumbs}
    updated={contentUpdated}
  >
    {
      enquiry ? (
        <>
          <Button href={contact.phone.href} icon="phone">
            <span class="sr-only">Anrufen: </span>{contact.phone.display}
          </Button>
          <a class="link-ink inline-flex min-h-11 items-center gap-3 font-semibold" href={contact.email.href}>
            <Icon name="mail" size={18} class="shrink-0 text-oxblood" />
            E-Mail schreiben
          </a>
          <Button href="#vorbereiten" variant="text">{audience.prepareTitle}</Button>
        </>
      ) : (
        <>
          <Button href={primaryCta.href} icon="calendar">Kostenlose Erstberatung</Button>
          <Button href="#leistungen" variant="text">Passende Leistungen</Button>
        </>
      )
    }
  </PageHeader>

  {
    audience.firstSteps && (
      <Section id="erste-schritte" label="Erste Schritte" title={audience.firstStepsTitle} tone="deep" axis>
        <ul class="grid gap-x-8 border-t border-ink md:grid-cols-2" data-reveal-group>
          {audience.firstSteps.map((step) => (
            <li class="grid content-start gap-3 border-b border-rule py-6" data-reveal>
              <h3 class="text-h4">{step.title}</h3>
              <p class="max-w-[34rem] text-graphite">{step.text}</p>
              {step.link && (
                <p>
                  <a class="link-ink inline-flex min-h-11 items-center font-semibold" href={step.link.href.startsWith('#') ? step.link.href : url(step.link.href)}>
                    {step.link.label}
                  </a>
                </p>
              )}
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  <Section id="ausgangslage" label="Ausgangslage" title={audience.situationTitle}>
    <div class="grid gap-12 md:grid-cols-12 md:gap-x-8">
      <ul class="grid content-start border-t border-ink md:col-span-9 md:col-start-4 lg:col-span-5 lg:col-start-4" data-reveal-group>
        {
          audience.situations.map((situation) => (
            <li class="border-b border-rule py-5 font-serif text-h4 text-ink" data-reveal>
              {situation}
            </li>
          ))
        }
      </ul>
      <figure class="md:col-span-9 md:col-start-4 lg:col-span-4 lg:col-start-9">
        <ArtImage
          src={picture.src}
          alt={picture.alt}
          ratio={4 / 3}
          position="center"
          crops={[{ media: '(min-width: 768px)', ratio: 4 / 5, position: 'center' }]}
          sizes="(min-width: 1344px) 520px, (min-width: 768px) 40vw, 100vw"
          widths={[400, 640, 880]}
        />
      </figure>
    </div>
  </Section>

  <Section id="hilfe" label="Unterstützung" title={audience.help.title}>
    <div class="grid gap-10 md:grid-cols-12 md:gap-x-8">
      <div class="grid content-start gap-5 md:col-span-9 md:col-start-4 xl:col-span-5 xl:col-start-4" data-reveal>
        {
          audience.help.paragraphs.map((paragraph, i) => (
            <p class:list={['max-w-[40rem]', i === 0 ? 'text-lead text-ink' : 'text-graphite']}>{paragraph}</p>
          ))
        }
        <div class="mt-4 max-w-[40rem] border-t border-rule pt-5">
          <h3 class="label text-graphite">Wo das Gutachten endet</h3>
          <ul class="mt-4 grid gap-3">
            {
              audience.limits.map((limit) => (
                <li class="grid grid-cols-[1.125rem_1fr] gap-3 text-graphite">
                  <Icon name="close" size={18} class="mt-0.5 text-stone" />
                  <span>{limit}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <ExpertCard class="self-start md:col-span-9 md:col-start-4 lg:col-span-5 lg:col-start-4 xl:col-span-3 xl:col-start-10" />
    </div>
  </Section>

  {enquiry && <AudiencePrepare audience={audience} tone="deep" />}

  {
    audience.court && (
      <Section
        id={audience.court === 'comparison' ? 'privat-oder-gericht' : 'bestellung'}
        label={audience.court === 'comparison' ? 'Vergleich' : 'Justiz'}
        title={audience.court === 'comparison' ? 'Privatgutachten oder Gerichtsgutachten?' : undefined}
        intro={
          audience.court === 'comparison'
            ? 'Den Unterschied macht der Auftraggeber: Ein Privatgutachten beauftragen Sie oder Ihr Mandant, ein Gerichtsgutachten holt das Gericht ein.'
            : undefined
        }
        tone={enquiry ? 'paper' : 'deep'}
        density="support"
      >
        <CourtReference class:list={[audience.court === 'comparison' && 'mb-16']} />
        {audience.court === 'comparison' && (
          <CompareTable caption="Privatgutachten und Gerichtsgutachten im Vergleich" {...reportComparison} />
        )}
      </Section>
    )
  }

  <Section
    id="leistungen"
    label="Leistungen"
    title="Welche Leistungen passen?"
    intro={
      enquiry
        ? 'Was geprüft wird und was das Gutachten enthält, steht bei der jeweiligen Leistung.'
        : 'Ihr Fall passt nicht eindeutig zu einer Leistung? Dann klären wir es in der kostenlosen Erstberatung, ohne dass Sie sich vorher festlegen.'
    }
  >
    <ServiceList services={services} />
    <div class="mt-10 md:grid md:grid-cols-12 md:gap-x-8" data-reveal>
      <p class="axis">
        <Button href="/leistungen/" variant="text">Alle Leistungen im Überblick</Button>
      </p>
    </div>
  </Section>

  {!enquiry && <AudiencePrepare audience={audience} tone="deep" />}

  {
    questions.length > 0 && (
      <Section id="fragen" label="Typische Fragen" title={`Häufige Fragen für ${audience.label}`} density="support" axis>
        <p slot="note">
          Alle Antworten nach Themen auf der Seite häufige Fragen.
        </p>
        <Faq items={questions} name={`faq-${audience.slug}`} />
        <p class="mt-8" data-reveal>
          <Button href="/haeufige-fragen/" variant="text">Alle häufigen Fragen</Button>
        </p>
      </Section>
    )
  }

  {
    articles.length > 0 && (
      <Section id="ratgeber" label="Ratgeber" title="Zum Weiterlesen" tone="deep" density="support">
        <ArticleList articles={articles} showLead={false} compact />
        <div class="mt-8 md:grid md:grid-cols-12 md:gap-x-8" data-reveal>
          <p class="axis">
            <Button href="/ratgeber/" variant="text">Alle Beiträge im Ratgeber</Button>
          </p>
        </div>
      </Section>
    )
  }

  {
    enquiry ? (
      <CtaBand
        title={audience.ctaTitle}
        text={audience.ctaText}
        action="contact"
        ctaLabel={`E-Mail an ${contact.email.display}`}
        ctaHref={contact.email.href}
      />
    ) : (
      <CtaBand title={audience.ctaTitle} text={audience.ctaText} />
    )
  }
</BaseLayout>
