---
// About Patrick Wolf: credentials as a CV style list, the path from tattoo artist to expert,
// court work, independence and the separation of studio and expert work, working principles.
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import KeyFacts, { type Fact } from '../components/ui/KeyFacts.astro';
import CourtReference from '../components/ui/CourtReference.astro';
import Quote from '../components/ui/Quote.astro';
import Seal from '../components/ui/Seal.astro';
import Icon from '../components/ui/Icon.astro';
import ArtImage from '../components/ui/ArtImage.astro';
import CtaBand from '../components/ui/CtaBand.astro';
import { Image } from 'astro:assets';
import { site, contact, credentials, contentUpdated, primaryCta } from '../config/site';
import { url } from '../lib/url';
import { ids, ref } from '../lib/schema';

const breadcrumbs = [{ label: 'Über mich', href: '/ueber-mich/' }];

import portrait from '../assets/images/patrick-wolf-portrait-studio-sitzend.jpg';
import closeUp from '../assets/images/patrick-wolf-nahaufnahme.jpg';
import atWork from '../assets/images/patrick-wolf-beim-taetowieren.webp';
import studio from '../assets/images/patrick-wolf-studio-weit.webp';
import badge from '../assets/images/rw-gutachterabzeichen-dgusv-logo.png';

const updatedText = new Intl.DateTimeFormat('de-DE', { day: 'numeric', month: 'long', year: 'numeric' }).format(
  new Date(contentUpdated),
);

const qualifications: Fact[] = [
  {
    term: 'Zertifizierung',
    value: `Geprüfter und zertifizierter Gutachter des ${credentials.associationShort}`,
    note: `${credentials.association}, Siegel ${credentials.sealYear}, Bestätigungs-Register Nr. ${credentials.registerNumber}.`,
  },
  {
    term: 'Gerichtliche Bestellung',
    value: `Sachverständiger am ${credentials.court}`,
    note: 'Erstmals in einem Gerichtsverfahren als Sachverständiger bestellt. Das ist keine öffentliche Bestellung und Vereidigung.',
  },
  {
    term: 'Mitgliedschaft',
    value: credentials.membership,
  },
  {
    term: 'Berufserfahrung',
    value: `Über ${credentials.yearsInTrade} Jahre im Tattoo- und Piercingbereich`,
    note: 'Aus handwerklicher und betrieblicher Sicht. Weiterhin als Tätowierer tätig.',
  },
  {
    term: 'Sitz',
    value: `${site.office}, ${contact.city}`,
    note: `${contact.street}, ${contact.postalCode} ${contact.city}`,
  },
  {
    term: 'Einsatzgebiet',
    value: 'Bundesweit und europaweit',
    note: 'Für Gerichte, Rechtsanwälte, Studios und Privatpersonen.',
  },
];

const principles = [
  'Persönliche und respektvolle Kommunikation, auf Augenhöhe',
  'Sorgfältiger Umgang mit sensiblen Sachverhalten',
  'Verständliche Darstellung auch komplexer fachlicher Zusammenhänge',
  'Feststellungen statt Behauptungen, jede Bewertung begründet',
];
---

<BaseLayout
  breadcrumbs={breadcrumbs}
  pageType="AboutPage"
  page={{ mainEntity: ref(ids(Astro.site).person) }}
  title={`Über mich: ${site.expert}, zertifizierter Tattoo Gutachter (${credentials.associationShort}) in ${contact.city}`}
  description={`${site.expert}: geprüfter und zertifizierter Gutachter des ${credentials.associationShort}, Sachverständiger am ${credentials.court}, über ${credentials.yearsInTrade} Jahre in der Tattoo- und Piercingbranche.`}
>
  <section aria-labelledby="person-titel">
    <Container class="pt-10 pb-16 md:pt-14 md:pb-24">
      <Breadcrumbs items={breadcrumbs} />
      <div class="mt-12 grid gap-12 md:mt-16 md:grid-cols-12 md:gap-x-8">
        <div class="md:col-span-7">
          <div class="hairline mb-4" data-reveal="rule" aria-hidden="true"></div>
          <Eyebrow>Über mich</Eyebrow>
          <p class="mt-3 text-sm text-graphite">Stand: <time datetime={contentUpdated}>{updatedText}</time></p>
          <h1 id="person-titel" class="mt-8 text-h1 tracking-display">
            {site.expert}, <em class="text-oxblood">Sachverständiger</em> für Tätowierungen und Piercings.
          </h1>
          <p class="mt-8 max-w-[36rem] text-lead text-graphite">
            Ich bin geprüfter und zertifizierter Gutachter des {credentials.associationShort} und seit über
            {credentials.yearsInTrade} Jahren beruflich in der Tattoo- und Piercingbranche tätig. Vom
            {site.office} in {contact.city} aus erstelle ich Gutachten bundesweit und europaweit, unabhängig davon, wer sie
            in Auftrag gibt.
          </p>
          <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-5">
            <Button href={primaryCta.href} icon="calendar">Kostenlose Erstberatung</Button>
            <Button href="#qualifikation" variant="text">Qualifikation</Button>
          </div>
        </div>
        <figure class="relative md:col-span-5">
          <ArtImage
            src={portrait}
            alt={`${site.expert}, zertifizierter Sachverständiger des ${credentials.associationShort}, sitzt im Studio und hört aufmerksam zu.`}
            ratio={4 / 5}
            position="right top"
            crops={[{ media: '(min-width: 768px)', ratio: 3 / 4, position: 'right top' }]}
            sizes="(min-width: 1344px) 520px, (min-width: 768px) 40vw, 100vw"
            widths={[400, 640, 880, 1037]}
            loading="eager"
            fetchpriority="high"
          />
          <div class="absolute -bottom-8 left-4 z-20 bg-paper p-1.5 shadow-[0_10px_30px_-12px_rgb(23_20_15/0.45)] md:-left-8" data-reveal>
            <Seal width={96} class="w-18 md:w-24" />
          </div>
        </figure>
      </div>
    </Container>
  </section>

  <Section
    id="qualifikation"
    label="Qualifikation"
    title="Qualifikation und Nachweise auf einen Blick."
    intro="Zertifizierung, gerichtliche Bestellung, Mitgliedschaft und Berufserfahrung, so wie sie belegt sind."
    tone="deep"
  >
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-x-8">
      <KeyFacts facts={qualifications} class="lg:col-span-8" />
      <div class="flex items-center gap-6 self-start lg:col-span-4 lg:flex-col lg:items-start" data-reveal>
        <Seal width={140} class="w-24 lg:w-[140px]" />
        <Image
          src={badge}
          alt={`Abzeichen geprüfter und zertifizierter Gutachter des ${credentials.associationShort}`}
          width={240}
          densities={[1, 2]}
          class="h-auto w-44 lg:w-60"
        />
      </div>
    </div>
  </Section>

  <section class="py-section" aria-labelledby="werdegang-titel">
    <Container class="grid gap-12 md:grid-cols-12 md:items-center md:gap-x-8">
      <div class="md:col-span-6 lg:col-span-7">
        <ArtImage
          src={atWork}
          alt={`${site.expert} mit Handschuhen bei konzentrierter Arbeit an einer Tätowierung.`}
          ratio={4 / 3}
          position="center"
          crops={[{ media: '(min-width: 768px)', ratio: 16 / 11, position: 'center' }]}
          sizes="(min-width: 1344px) 720px, (min-width: 768px) 50vw, 100vw"
          widths={[480, 720, 960, 1120]}
          parallax
        />
      </div>
      <div class="md:col-span-6 lg:col-span-5">
        <Eyebrow>Werdegang</Eyebrow>
        <h2 id="werdegang-titel" class="mt-6 text-h2 tracking-display" data-reveal>Vom Tätowierer zum Sachverständigen.</h2>
        <div class="mt-6 grid gap-4 text-graphite" data-reveal>
          <p class="text-ink">
            Wer eine Tätowierung fachgerecht bewerten will, muss das Handwerk verstehen. Die Beurteilung verlangt mehr als
            den Blick auf das fertige Motiv.
          </p>
          <p>
            Was mit der Leidenschaft für das Tätowieren begann, ist über mehr als zwei Jahrzehnte zu einem breiten
            Erfahrungsschatz geworden: unterschiedliche Tätowiertechniken, Hautbeschaffenheiten, Materialien, hygienische
            Anforderungen und die besonderen Herausforderungen des Handwerks.
          </p>
          <p>
            Entscheidend sind Kenntnisse über Arbeitsmethoden, das Zusammenspiel von Nadel, Farbe und Haut und die Ursachen
            handwerklicher Fehler. Ich kenne die Branche aus handwerklicher und aus betrieblicher Sicht. Um dieses Wissen in
            unabhängigen Begutachtungen einzusetzen, habe ich mich zusätzlich als Gutachter qualifiziert.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <Section
    id="justiz"
    label="Justiz"
    title="Sachverständigentätigkeit für die Justiz."
    intro="Das Landgericht Frankfurt am Main hat mich erstmals in einem Gerichtsverfahren als Sachverständigen bestellt. Gerichtliche Fragen müssen präzise beantwortet und die Feststellungen verständlich dokumentiert werden."
    tone="deep"
  >
    <p slot="note">
      Meine Aufgabe ist, Praxiserfahrung und Fachkenntnis in eine sachliche, nachvollziehbare und unvoreingenommene
      Bewertung einzubringen.
    </p>
    <CourtReference />
    <p class="mt-10" data-reveal>
      <Button href="/leistungen/gerichtsgutachten/" variant="text">Gutachten für Gerichte</Button>
    </p>
  </Section>

  <section class="py-section" aria-labelledby="unabhaengig-titel">
    <Container class="grid gap-12 md:grid-cols-12 md:gap-x-8">
      <div class="md:col-span-6 lg:col-span-6">
        <Eyebrow>Unabhängigkeit</Eyebrow>
        <h2 id="unabhaengig-titel" class="mt-6 text-h2 tracking-display" data-reveal>
          Unabhängigkeit hat für mich höchste Priorität.
        </h2>
        <div class="mt-6 grid gap-4 text-graphite" data-reveal>
          <p class="text-ink">
            Ich vertrete keine vorgefassten Positionen. Ob mich eine Privatperson, ein Tattoo-Studio, ein Rechtsanwalt oder
            ein Gericht beauftragt: Die Bewertung stützt sich allein auf feststellbare Tatsachen, physikalische Gegebenheiten
            und objektive fachliche Standards.
          </p>
          <p>
            Ein Gutachten darf weder einen Auftraggeber bevorzugen noch ein Wunschergebnis bestätigen. Es dient einer
            verlässlichen, unparteiischen Klärung des Sachverhalts.
          </p>
        </div>
        <h3 class="mt-12 text-h3" data-reveal>Zwei Tätigkeitsbereiche, klar getrennt.</h3>
        <div class="mt-4 grid gap-4 text-graphite" data-reveal>
          <p>
            Neben der Sachverständigentätigkeit arbeite ich weiterhin als Tätowierer. Damit beide Bereiche sauber getrennt
            bleiben, habe ich mit {site.domain} einen eigenständigen Auftritt geschaffen, der sich ausschließlich der Arbeit
            als Sachverständiger widmet.
          </p>
          <p>
            Die Praxiserfahrung bleibt die Grundlage meiner Fachkompetenz. Die Begutachtung selbst erfolgt unabhängig und
            unparteiisch.
          </p>
        </div>
      </div>
      <div class="grid content-start gap-8 md:col-span-5 md:col-start-8">
        <ArtImage
          src={studio}
          alt={`${site.expert} sitzt lächelnd in seinem Studio in ${contact.city} zwischen den Behandlungsliegen.`}
          ratio={4 / 3}
          position="center"
          sizes="(min-width: 1344px) 520px, (min-width: 768px) 40vw, 100vw"
          widths={[400, 640, 880, 1286]}
        />
        <ArtImage
          src={closeUp}
          alt={`Nahaufnahme von ${site.expert}, der freundlich in die Kamera blickt.`}
          ratio={1}
          position="left top"
          sizes="(min-width: 1344px) 320px, (min-width: 768px) 25vw, 60vw"
          widths={[320, 480, 640]}
          class="w-3/5 justify-self-end"
        />
      </div>
    </Container>
  </section>

  <Section
    id="philosophie"
    label="Philosophie"
    title="Wie ich arbeite."
    intro="Hinter jeder Beauftragung steht ein Mensch, ein Unternehmen oder ein Verfahren, oft verbunden mit Enttäuschung, Schmerzen oder einem Rechtsstreit. Darauf ist meine Arbeitsweise ausgerichtet."
    tone="deep"
  >
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-x-8">
      <Quote author={site.expert} role={`Geprüfter und zertifizierter Gutachter des ${credentials.associationShort} für Tattoo und Piercing`} class="lg:col-span-7">
        Ein gutes Gutachten überzeugt nicht durch Behauptungen, sondern durch nachvollziehbare Feststellungen, fachliche
        Begründungen und Objektivität.
      </Quote>
      <ul class="grid content-start gap-4 border-t border-ink pt-6 lg:col-span-5" data-reveal>
        {
          principles.map((item) => (
            <li class="grid grid-cols-[1.125rem_1fr] gap-3">
              <Icon name="check" size={18} class="mt-0.5 text-oxblood" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Section id="weiter" label="Weiterlesen" title="Was ich für Sie prüfe und wie es abläuft.">
    <ul class="grid gap-4 border-t border-ink pt-6 md:grid-cols-3 md:gap-x-8" data-reveal-group>
      <li data-reveal>
        <a class="link-ink font-serif text-h4" href={url('/leistungen/')}>Alle Leistungen</a>
        <p class="mt-2 text-sm text-graphite">Tattoo-, Hygiene- und Piercing-Gutachten, Privat- und Gerichtsgutachten, Streitfälle.</p>
      </li>
      <li data-reveal>
        <a class="link-ink font-serif text-h4" href={url('/ablauf-kosten/')}>Ablauf und Kosten</a>
        <p class="mt-2 text-sm text-graphite">Fünf Schritte, kostenlose Erstberatung, Kosten nach Aufwand.</p>
      </li>
      <li data-reveal>
        <a class="link-ink font-serif text-h4" href={url('/haeufige-fragen/')}>Häufige Fragen</a>
        <p class="mt-2 text-sm text-graphite">Antworten zu Begutachtung, Auftrag, Gericht und Kosten.</p>
      </li>
    </ul>
  </Section>

  <CtaBand
    title="Sprechen wir über Ihren Fall."
    text="Die Erstberatung dauert bis zu 60 Minuten, ist kostenlos und verpflichtet Sie zu nichts. Gutachten bundesweit und europaweit."
  />
</BaseLayout>
