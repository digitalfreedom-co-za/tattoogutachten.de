---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Tattoogutachten, Sachverständigenbüro Wolf"
  description="Gutachten zu Tattoos und Piercings. Die neue Website ist in Arbeit."
>
  <main class="mx-auto flex min-h-screen max-w-2xl flex-col justify-center px-6 py-16">
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Tattoogutachten</h1>
    <p class="mt-4 text-lg text-neutral-700">
      Sachverständigenbüro Wolf, Bad Nauheim. Gutachten zu Tattoos und Piercings.
    </p>
    <p class="mt-2 text-neutral-600">Die neue Website ist in Arbeit.</p>
  </main>
</BaseLayout>
