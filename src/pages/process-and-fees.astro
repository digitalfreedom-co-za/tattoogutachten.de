---
// English process and fees page (German: src/pages/de/ablauf-kosten.astro): the five steps in detail,
// the cost logic without invented prices, private versus court commission, the preparation checklist
// and the cost FAQ.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import Steps from '../components/ui/Steps.astro';
import KeyFacts from '../components/ui/KeyFacts.astro';
import Checklist from '../components/ui/Checklist.astro';
import CompareTable from '../components/ui/CompareTable.astro';
import Faq from '../components/ui/Faq.astro';
import CtaBand from '../components/ui/CtaBand.astro';
import EnquiryNote from '../components/ui/EnquiryNote.astro';
import { practiceFor } from '../config/practice';
import { contentUpdated, primaryCtaFor } from '../config/site';
import { steps, costFacts, costDrivers, contractTerms, preparationChecklist } from '../data/en/process';
import { reportComparison } from '../data/en/services';
import { faqByTopic } from '../data/en/faq';
import { url } from '../lib/url';

const costQuestions = faqByTopic('kosten');
const practice = practiceFor('en');
const primaryCta = primaryCtaFor('en');
const breadcrumbs = [{ label: 'Process and fees', href: '/process-and-fees/' }];
---

<BaseLayout
  breadcrumbs={breadcrumbs}
  title="Expert reports on tattoos: process and fees | Free 60 minute consultation"
  description="How an expert report on a tattoo works: free first consultation of up to 60 minutes, fees based on the work involved and agreed in writing beforehand, under the JVEG for court commissions."
>
  <PageHeader
    label="Process and fees"
    heading="Process and fees of an expert report on a tattoo."
    lead="An expert report begins with a free first consultation of up to 60 minutes. Fees only arise once you commission the report in writing, and the expected range is fixed beforehand."
    breadcrumbs={breadcrumbs}
    updated={contentUpdated}
  >
    <Button href={primaryCta.href} icon="calendar">Free first consultation</Button>
    <Button href="#fees" variant="text">Straight to the fees</Button>
  </PageHeader>

  <Section
    id="process"
    label="Process"
    title="How does an expert report on a tattoo work?"
    intro="In five steps: first consultation, clarifying scope and fees, written commission, examination and report. Fees only arise from the third step onwards."
    tone="deep"
  >
    <p slot="note">
      Hardly anyone commissions an expert every day. It is often unclear whether a report is needed, which documents are
      required and what it costs. That is why everything starts with a thorough conversation.
    </p>
    <Steps steps={steps} detailed />
  </Section>

  <Section
    id="fees"
    label="Fees"
    title="What does an expert report on a tattoo cost?"
    intro="There is no flat price, because the work and scope vary considerably from case to case. The fees depend on the work involved and are agreed in writing before a private commission."
  >
    <p slot="note">
      A simple written opinion takes a different amount of work than an extensive report with several questions to answer, additional documentation or an on-site inspection.
    </p>
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-x-8">
      <KeyFacts facts={costFacts} class="lg:col-span-7" />
      <div class="grid content-start gap-8 lg:col-span-5">
        <Checklist title="What the fees depend on" items={costDrivers} />
        <Checklist title="Set out in writing before the commission" items={contractTerms} />
      </div>
    </div>
    <p class="mt-10 max-w-[40rem] text-graphite" data-reveal>
      You receive the terms of remuneration and the expected fees before any chargeable work begins.
    </p>
  </Section>

  <Section
    id="private-or-court"
    label="Comparison"
    title="Private commission or court: which rules apply to the fees?"
    intro="That depends on who commissions the report. A private expert report follows the terms agreed in the expert contract; for a court report the fees follow the JVEG (German Judicial Remuneration and Compensation Act) and are settled through the court."
    tone="deep"
  >
    <CompareTable caption="Private expert report and court report compared" {...reportComparison} />
    <p class="mt-10 max-w-[40rem] text-graphite" data-reveal>
      More on both routes on the pages
      <a class="link-ink" href={url('/services/private-reports/')}>private expert reports and preserving evidence</a> and
      <a class="link-ink" href={url('/services/court-reports/')}>expert reports for courts</a>.
    </p>
  </Section>

  <Section
    id="preparation"
    label="Preparation"
    title="What should you bring to the first consultation?"
    intro="The more you can show, the more precise the first assessment. Which documents are actually needed is something we clarify in the conversation."
  >
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-x-8">
      <Checklist title="Have ready for the first consultation" items={preparationChecklist} class="self-start lg:col-span-7" />
      <div class="grid content-start gap-5 lg:col-span-5" data-reveal>
        <h3 class="text-h4">How long does an expert report take?</h3>
        <p class="text-graphite">
          That depends on the scope of the commission, the available documents and the work the examination requires.
          {practice.reportTurnaround && ` ${practice.reportTurnaround}`} After the first consultation the time needed can
          usually be estimated more precisely, and the expected processing period is then stated in the contract.
        </p>
        <EnquiryNote />
      </div>
    </div>
  </Section>

  <Section id="faq" label="FAQ" title="Questions on fees and process" tone="deep">
    <p slot="note">
      All questions by topic:
      <a class="link-ink not-italic" href={url('/faq/')}>frequently asked questions about expert reports on tattoos</a>.
    </p>
    <Faq items={costQuestions} name="faq-fees" />
  </Section>

  <CtaBand
    title="Arrange your free first consultation now."
    text="Would you like to know whether an expert report makes sense for your concern? The first consultation lasts up to 60 minutes, is free of charge and without obligation."
  />
</BaseLayout>
