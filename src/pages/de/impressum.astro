---
// Impressum (§ 5 DDG) of RuW Lifestyle GmbH, incl. the professional details of the expert.
// Legal facts come from src/config/site.ts; the wording follows the imprint of the old site.
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { site, company, contact, credentials, contentUpdated, type NavItem } from '../../config/site';
import { ids, ref } from '../../lib/schema';
import { url } from '../../lib/url';

const title = `Impressum | ${site.name}`;
const description = `Impressum von ${site.domain}: ${company.name}, ${company.street}, ${contact.postalCode} ${contact.city}, vertreten durch ${company.managingDirector}.`;
const breadcrumbs: NavItem[] = [{ label: 'Impressum', href: '/de/impressum/' }];

---

<ArticleLayout
  title={title}
  description={description}
  heading="Impressum"
  lead={`Anbieter dieser Internetseite ist die ${company.name} in ${contact.city}.`}
  label="Rechtliches"
  breadcrumbs={breadcrumbs}
  updated={contentUpdated}
  page={{ about: ref(ids(Astro.site).company) }}
>
  <h2>Angaben gemäß § 5 Digitale-Dienste-Gesetz (DDG)</h2>
  <p>
    {company.name}<br />
    {company.street}<br />
    {contact.postalCode} {contact.city}<br />
    {contact.country}
  </p>
  <p>
    Vertreten durch den Geschäftsführer:<br />
    {company.managingDirector}
  </p>

  <h2>Kontakt</h2>
  <p>
    Telefon: <a href={contact.phone.href}>{contact.phone.display}</a><br />
    E-Mail: <a class="break-all" href={contact.email.href}>{contact.email.display}</a><br />
    Internet: {company.website}
  </p>

  <h2>Handelsregister</h2>
  <p>
    Registergericht: {company.registerCourt}<br />
    Registernummer: {company.registerNumber}
  </p>

  <h2>Umsatzsteuer-Identifikationsnummer</h2>
  <p>
    Umsatzsteuer-Identifikationsnummer gemäß § 27a Umsatzsteuergesetz:<br />
    {company.vatId}
  </p>

  <h2>Berufsbezogene Angaben</h2>
  <p>
    {site.expert}<br />
    Geprüfter und zertifizierter Gutachter des Deutschen Gutachter und Sachverständigen Verbandes
    ({credentials.associationShort})
  </p>
  <p>Sachverständigentätigkeit im Bereich Tätowierungen und Piercings.</p>
  <p>Über {credentials.yearsInTrade} Jahre praktische Berufserfahrung im Tattoo- und Piercingwesen.</p>
  <p>Mitglied im {credentials.membership}.</p>
  <p>{site.expert} wurde durch das {credentials.court} in einem Gerichtsverfahren als Sachverständiger bestellt.</p>
  <p>
    Die gerichtliche Bestellung in einem einzelnen Verfahren stellt keine öffentliche Bestellung und Vereidigung als
    Sachverständiger dar.
  </p>

  <h2>Verbraucher&shy;streit&shy;beilegung gemäß § 36 VSBG</h2>
  <p>
    Die {company.name} ist weder verpflichtet noch bereit, an Streitbeilegungsverfahren vor einer
    Verbraucherschlichtungsstelle teilzunehmen.
  </p>

  <h2>Verantwortlichkeit für Inhalte</h2>
  <p>
    Die {company.name} ist als Diensteanbieter für die eigenen Inhalte dieser Internetseite nach den allgemeinen
    gesetzlichen Vorschriften verantwortlich.
  </p>
  <p>
    Für fremde Inhalte, auf die über externe Verlinkungen verwiesen wird, gelten die gesetzlichen Bestimmungen. Eine
    Haftung richtet sich nach den jeweils anwendbaren gesetzlichen Vorschriften.
  </p>

  <h2>Urheberrecht</h2>
  <p>
    Die auf dieser Internetseite veröffentlichten Texte, Fotografien, Grafiken und sonstigen Inhalte unterliegen,
    soweit urheberrechtlich geschützt, dem deutschen Urheberrecht.
  </p>
  <p>
    Eine Vervielfältigung, Bearbeitung, Verbreitung oder sonstige Verwertung außerhalb der gesetzlichen Schranken des
    Urheberrechts bedarf der Zustimmung des jeweiligen Rechteinhabers.
  </p>
  <p>Soweit Inhalte von Dritten verwendet werden, werden deren Rechte beachtet.</p>

  <div slot="aside" class="grid gap-8">
    <div>
      <p class="label text-ink">Anbieter</p>
      <p class="mt-3 font-serif text-h4 text-ink">{company.name}</p>
      <p class="mt-2">
        {company.street}, {contact.postalCode} {contact.city}. Vertreten durch den Geschäftsführer
        {company.managingDirector}.
      </p>
    </div>
    <div class="border-t border-rule pt-5">
      <p class="label text-ink">Datenschutz</p>
      <p class="mt-3">
        Welche Daten beim Besuch dieser Seiten und bei der Terminbuchung verarbeitet werden, steht in der
        <a class="link-ink font-semibold" href={url('/de/datenschutz/')}>Datenschutzerklärung</a>.
      </p>
    </div>
  </div>
</ArticleLayout>
