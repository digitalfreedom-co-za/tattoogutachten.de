---
// Ratgeber index: all articles from the content collection, the audience pages and a CTA.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/ui/PageHeader.astro';
import Section from '../../../components/ui/Section.astro';
import Card from '../../../components/ui/Card.astro';
import ArticleList from '../../../components/ui/ArticleList.astro';
import CtaBand from '../../../components/ui/CtaBand.astro';
import { site, credentials, contentUpdated } from '../../../config/site';
import { audiences, audienceHref } from '../../../data/audiences';
import { getArticles, articleHref } from '../../../lib/ratgeber';
import { absoluteUrl, ids, ref } from '../../../lib/schema';
import { url } from '../../../lib/url';

const articles = await getArticles('de');
const breadcrumbs = [{ label: 'Ratgeber', href: '/de/ratgeber/' }];
const description = `Ratgeber von Tattoo Gutachter ${site.expert}: Tattoo misslungen, Mangel oder Geschmack, Privat- oder Gerichtsgutachten, Fotos, Hygiene, Piercing Probleme.`;

const page = {
  author: ref(ids(Astro.site).person),
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: articles.map((article, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: article.data.title,
      url: absoluteUrl(articleHref(article), Astro.site),
    })),
  },
};
---

<BaseLayout
  title="Ratgeber zum Tattoo-Gutachten: Mängel, Fotos, Hygiene, Gericht"
  description={description}
  breadcrumbs={breadcrumbs}
  pageType="CollectionPage"
  page={page}
>

  <PageHeader
    label="Ratgeber"
    heading="Ratgeber zum Tattoo-Gutachten."
    lead={`Kurze, sachliche Antworten auf die Fragen, die vor einem Gutachten am häufigsten auftauchen. Geschrieben von ${site.expert}, geprüfter und zertifizierter Gutachter des ${credentials.associationShort}. Die Beiträge informieren allgemein und ersetzen keine Rechtsberatung.`}
    breadcrumbs={breadcrumbs}
    updated={contentUpdated}
  />

  <Section id="beitraege" label="Beiträge" title="Alle Beiträge">
    <p slot="note">
      Gerade erst bemerkt, dass etwas nicht stimmt? Dann beginnen Sie mit
      <a class="link-ink not-italic" href={url('/de/ratgeber/tattoo-misslungen-was-tun/')}>Tattoo misslungen, was jetzt?</a>
    </p>
    <ArticleList articles={articles} />
  </Section>

  <Section
    id="fuer-wen"
    label="Für wen"
    title="Informationen nach Auftraggeber"
    intro="Ein Kunde fragt nach dem Mangel, ein Studio nach dem Vorwurf, ein Gericht nach den Beweisfragen. Wählen Sie Ihre Seite."
    tone="deep"
  >
    <div class="grid gap-x-8 gap-y-4 md:grid-cols-2 xl:grid-cols-4" data-reveal-group>
      {
        audiences.map((audience) => (
          <Card kicker={audience.label} title={audience.title} href={audienceHref(audience)} linkLabel={`Mehr für ${audience.label}`}>
            <p>{audience.text}</p>
          </Card>
        ))
      }
    </div>
  </Section>

  <CtaBand
    title="Ihr Fall ist nicht dabei?"
    text="Nicht jeder Sachverhalt lässt sich mit einer allgemeinen Antwort klären. Ihr Anliegen besprechen wir gern in einer kostenlosen Erstberatung von bis zu 60 Minuten."
  />
</BaseLayout>
