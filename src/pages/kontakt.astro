---
// Contact: office address with a plain maps link, phone, email, area served and the booking CTA.
// No form and no embedded map on purpose, so nothing loads from third parties on this page.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import Icon, { type IconName } from '../components/ui/Icon.astro';
import Seal from '../components/ui/Seal.astro';
import CtaBand from '../components/ui/CtaBand.astro';
import EnquiryNote from '../components/ui/EnquiryNote.astro';
import { site, contact, credentials, contentUpdated, primaryCta, type NavItem } from '../config/site';
import { practice } from '../config/practice';
import { audiences, audienceHref } from '../data/audiences';
import { ids, ref } from '../lib/schema';
import { url } from '../lib/url';

const title = `Kontakt: ${site.office}, Tattoo Gutachter in ${contact.city}`;
const description = `Tattoo Gutachter ${site.expert}: ${site.office}, ${contact.street}, ${contact.postalCode} ${contact.city}. Telefon ${contact.phone.display}, E-Mail oder Online-Termin.`;
const breadcrumbs: NavItem[] = [{ label: 'Kontakt', href: '/kontakt/' }];

interface Channel {
  icon: IconName;
  term: string;
  value: string;
  href: string;
  note: string;
  external?: boolean;
}

const channels: Channel[] = [
  {
    icon: 'phone',
    term: 'Telefon',
    value: contact.phone.display,
    href: contact.phone.href,
    note: 'Für kurze Fragen und um einen Termin abzusprechen.',
  },
  {
    icon: 'mail',
    term: 'E-Mail',
    value: contact.email.display,
    href: contact.email.href,
    note: 'Für Anfragen mit Fotos und Unterlagen, für Kanzleien und Gerichte.',
  },
  {
    icon: 'pin',
    term: 'Büroanschrift',
    value: `${contact.street}, ${contact.postalCode} ${contact.city}`,
    href: contact.mapsUrl,
    note: [practice.officeVisits, 'Der Link öffnet die Route in Google Maps.'].filter(Boolean).join(' '),
    external: true,
  },
];

---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={breadcrumbs}
  pageType="ContactPage"
  page={{ mainEntity: ref(ids(Astro.site).office) }}
>
  <PageHeader
    label="Kontakt"
    heading={`Kontakt zu Tattoo Gutachter ${site.expert}.`}
    lead={`Sie erreichen ${site.expert} telefonisch unter ${contact.phone.display}, per E-Mail oder über die Online-Terminbuchung. Das Büro sitzt in ${contact.city}, Gutachten entstehen ${credentials.areaServed}.`}
    breadcrumbs={breadcrumbs}
    updated={contentUpdated}
  >
    <Button href={contact.phone.href} icon="phone">
      <span class="sr-only">Anrufen: </span>{contact.phone.display}
    </Button>
    <Button href={contact.email.href} variant="secondary" icon="mail">E-Mail schreiben</Button>
    <Button href="/termin/" variant="text" icon="calendar">{primaryCta.label}</Button>
  </PageHeader>

  <Section
    id="kontaktdaten"
    label="Kontaktdaten"
    title="Telefon, E-Mail und Büroanschrift."
    intro="Rufen Sie an, schreiben Sie eine E-Mail oder buchen Sie die kostenlose Erstberatung online."
    tone="deep"
  >
    <dl class="border-t border-ink" data-reveal-group>
        {
          channels.map((channel) => (
            <div class="grid gap-2 border-b border-rule py-6 md:grid-cols-12 md:gap-x-8" data-reveal>
              <dt class="label flex items-center gap-3 pt-1 text-graphite md:col-span-3">
                <Icon name={channel.icon} size={18} class="shrink-0 text-oxblood" />
                {channel.term}
              </dt>
              <dd class="min-w-0 md:col-span-9 lg:col-span-8">
                <a
                  class="link-ink inline-flex min-h-11 items-center font-serif text-h4 break-words"
                  href={channel.href}
                  {...(channel.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  {channel.value}
                  {channel.external && <span class="sr-only"> (öffnet Google Maps in einem neuen Fenster)</span>}
                </a>
                <p class="mt-2 text-sm text-graphite">{channel.note}</p>
              </dd>
            </div>
          ))
        }
      </dl>

    <div class="mt-12 grid gap-10 md:grid-cols-12 md:gap-x-8">
      <EnquiryNote class="md:col-span-9 md:col-start-4 lg:col-span-4 lg:col-start-4" />
      <aside class="border border-ink bg-paper p-6 md:col-span-9 md:col-start-4 md:p-8 lg:col-span-4 lg:col-start-8" data-reveal>
          <p class="label text-graphite">Erstberatung</p>
          <p class="mt-4 font-serif text-h3 tracking-tightish">Kostenlos, bis zu 60 Minuten.</p>
          <p class="mt-4 text-graphite">
            Freie Termine sehen Sie direkt im Kalender. Die Bestätigung kommt per E-Mail.
          </p>
          <div class="mt-6">
            <Button href="/termin/" variant="secondary" icon="calendar">Termin online buchen</Button>
          </div>
      </aside>
    </div>
  </Section>

  <Section
    id="einsatzgebiet"
    label="Einsatzgebiet"
    title="Wo ist Patrick Wolf als Gutachter tätig?"
    intro={`Bundesweit und europaweit. Das ${site.office} hat seinen Sitz in ${contact.city} in Hessen und arbeitet für Auftraggeber in ganz Deutschland und im europäischen Ausland.`}
    density="support"
  >
    <div class="grid gap-10 md:grid-cols-12 md:gap-x-8">
      <div class="grid content-start gap-4 text-graphite md:col-span-9 md:col-start-4 lg:col-span-5 lg:col-start-4" data-reveal>
        <p>
          Eine erste Einschätzung ist mit aussagekräftigen Fotos oft ohne Anreise möglich. Ob für das Gutachten eine
          persönliche Untersuchung oder eine Besichtigung von Räumen nötig ist, klären wir in der Erstberatung.
        </p>
        <p>
          Gutachten entstehen für Privatpersonen, Tattoo- und Piercingstudios, Rechtsanwälte und Gerichte. Mehr dazu auf
          den Seiten
          {
            audiences.map((audience, index) => (
              <><a class="link-ink" href={url(audienceHref(audience))}>für {audience.label}</a>{index < audiences.length - 2 ? ', ' : index === audiences.length - 2 ? ' und ' : '.'}</>
            ))
          }
        </p>
      </div>
      <div class="flex flex-wrap items-start gap-6 md:col-span-9 md:col-start-4 lg:col-span-4 lg:col-start-9" data-reveal>
        <Seal width={96} class="w-20 shrink-0 md:w-24" />
        <p class="min-w-0 flex-1 basis-64 text-sm text-graphite">
          Geprüfter und zertifizierter Gutachter des {credentials.associationShort}, Bestätigungs-Register
          <span class="numeral whitespace-nowrap text-ink">Nr. {credentials.registerNumber}</span>. Mehr zur Qualifikation auf der Seite
          <a class="link-ink" href={url('/ueber-mich/')}>über {site.expert}</a>.
        </p>
      </div>
    </div>
  </Section>

  <CtaBand
    title="Klären wir Ihr Anliegen in einem kostenlosen Gespräch."
    text="Die Erstberatung dauert bis zu 60 Minuten und verpflichtet Sie zu nichts. Was ein Gutachten kostet und wie es abläuft, steht vorab auf der Seite Ablauf und Kosten."
  />
</BaseLayout>
