---
// All SEO tags of a page: title, description, canonical, robots, hreflang, Open Graph, Twitter and one
// JSON-LD @graph (site wide entities, the WebPage, its breadcrumb trail and the page's own nodes).
// Absolute URLs come from Astro.site plus the base path, indexing from the switch in config/site.ts.
// hreflang lists both language versions of the page plus x-default, which points at the English
// version: the default locale is served to everyone at the root, without a language redirect.
import { getImage } from 'astro:assets';
import JsonLd from './JsonLd.astro';
import { site, indexable, ogImage, ogImageAltFor, type NavItem } from '../../config/site';
import { absoluteUrl, breadcrumbList, siteGraph, webPageNode, type JsonLdNode } from '../../lib/schema';
import { withoutBase } from '../../lib/url';
import { pageLocale, localeMeta, locales, defaultLocale, routes, type PathPair } from '../../i18n';
import portrait from '../../assets/images/patrick-wolf-portrait-studio-sitzend.jpg';

export interface SeoProps {
  title: string;
  description: string;
  /** Trail without Start, as passed to Breadcrumbs.astro; also yields the BreadcrumbList. */
  breadcrumbs?: NavItem[];
  /** WebPage subtype and extra properties for the page node. */
  pageType?: string;
  page?: JsonLdNode;
  /** Additional nodes of this page (Service, Article ...). */
  schema?: JsonLdNode[];
  ogType?: 'website' | 'article';
  /** ISO dates for article pages. */
  published?: string;
  modified?: string;
  /** Never index this page, whatever the switch says (404). */
  noindex?: boolean;
}

type Props = SeoProps & {
  /** Both language versions of this page (BaseLayout), null for pages without a pair. */
  alternates: PathPair | null;
};

const { title, description, breadcrumbs, pageType, page, schema = [], ogType = 'website', published, modified, noindex = false, alternates } =
  Astro.props;
const locale = pageLocale(Astro.url);
const otherLocales = locales.filter((candidate) => candidate !== locale);
const imageAlt = ogImageAltFor(locale);

const path = withoutBase(Astro.url.pathname);
const canonical = absoluteUrl(path, Astro.site);
const robots = noindex || !indexable ? 'noindex' : 'index, follow, max-image-preview:large, max-snippet:-1';
const image = absoluteUrl(ogImage.path, Astro.site);

const portraitImage = await getImage({ src: portrait, width: 800, format: 'jpeg' });
const graph = noindex
  ? null
  : {
      '@graph': [
        ...siteGraph(Astro.site, new URL(portraitImage.src, Astro.site).href, locale),
        webPageNode({ path, name: title, description, type: pageType, breadcrumbs, extra: page, locale }, Astro.site),
        ...(breadcrumbs?.length ? [breadcrumbList(breadcrumbs, path, Astro.site, locale)] : []),
        ...schema,
      ],
    };
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<meta name="author" content={site.expert} />
{!noindex && <link rel="canonical" href={canonical} />}
{
  !noindex && alternates && (
    <>
      {locales.map((code) => <link rel="alternate" hreflang={localeMeta[code].lang} href={absoluteUrl(alternates[code], Astro.site)} />)}
      <link rel="alternate" hreflang="x-default" href={absoluteUrl(alternates[defaultLocale], Astro.site)} />
    </>
  )
}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={localeMeta[locale].og} />
{alternates && otherLocales.map((code) => <meta property="og:locale:alternate" content={localeMeta[code].og} />)}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{!noindex && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={image} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content={String(ogImage.width)} />
<meta property="og:image:height" content={String(ogImage.height)} />
<meta property="og:image:alt" content={imageAlt} />
{ogType === 'article' && published && <meta property="article:published_time" content={published} />}
{ogType === 'article' && modified && <meta property="article:modified_time" content={modified} />}
{ogType === 'article' && <meta property="article:author" content={absoluteUrl(routes.about[locale], Astro.site)} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />

<link rel="alternate" type="text/plain" title="llms.txt" href={absoluteUrl(`${routes.home[locale]}llms.txt`, Astro.site)} />
{graph && <JsonLd data={graph} />}
