---
// Mobile only booking bar fixed to the bottom edge, above the home indicator (safe area).
// It needs JS to know when to step aside: it hides once the calendar frame of a booking section
// ([data-booking-section], the section itself if it has no calendar) reaches the usable viewport
// between header and bar, or while the footer is on screen, so it stays available through the
// introduction and never covers the calendar or the contact details. Below 360px it drops the
// supporting line and keeps only the booking button, so the bar stays one row high. While hidden
// it leaves the focus order, as it does while the mobile menu is open. Its measured height is the
// bottom scroll padding and the body padding, and a focused element that still ends up behind
// the bar is scrolled clear of it, so keyboard focus is never hidden.
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import { primaryCta } from '../../config/site';
import { bookingHref } from '../../config/booking';
import { url, withoutBase } from '../../lib/url';

const href = url(bookingHref(withoutBase(Astro.url.pathname)));
---

<aside class="sticky-cta md:hidden" aria-label="Erstberatung buchen" data-sticky-cta hidden>
  <Container class="flex items-center justify-between gap-4 py-3">
    <p class="text-sm leading-snug text-paper/75 max-[359px]:hidden">
      Erstberatung kostenlos,<br />bis zu 60 Minuten
    </p>
    <a
      href={href}
      class="inline-flex min-h-11 shrink-0 items-center justify-center gap-3 rounded-xs max-[359px]:flex-1 border border-paper bg-paper px-5 py-3 text-[0.9375rem] font-semibold leading-none text-ink transition-colors hover:border-brass-light hover:bg-brass-light"
    >
      <span>{primaryCta.label}</span>
      <Icon name="calendar" size={18} class="shrink-0" />
    </a>
  </Container>
</aside>

<style>
  .sticky-cta {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 30;
    padding-bottom: env(safe-area-inset-bottom);
    background: var(--color-ink);
    color: var(--color-paper);
    box-shadow: 0 -10px 30px -18px rgb(23 20 15 / 0.6);
    transition:
      transform 300ms var(--ease-out-quint),
      visibility 0s linear 0s;
  }

  .sticky-cta[data-away] {
    transform: translateY(100%);
    visibility: hidden;
    transition:
      transform 300ms var(--ease-out-quint),
      visibility 0s linear 300ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .sticky-cta,
    .sticky-cta[data-away] {
      transition: none;
    }
  }

  /* Room for the bar, mobile only and only when the bar exists. --sticky-cta-height is measured by
     the script below and includes the safe area; 4.5rem plus safe area is the first paint value. */
  @media (max-width: 47.99rem) {
    :global(html.has-sticky-cta) {
      scroll-padding-bottom: calc(var(--sticky-cta-height, 4.5rem) + 0.5rem);
    }

    :global(html.has-sticky-cta body) {
      padding-bottom: var(--sticky-cta-height, calc(4.5rem + env(safe-area-inset-bottom)));
    }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-sticky-cta]');
  const menu = document.getElementById('mobile-nav');
  const header = document.getElementById('site-header');
  // The interactive calendar, not the whole section: its heading and intro stay bar territory.
  const calendars = Array.from(document.querySelectorAll<HTMLElement>('[data-booking-section]'), (section) =>
    section.querySelector<HTMLElement>('.booking-frame') ?? section,
  );
  const footers = document.querySelectorAll<HTMLElement>('footer');

  if (bar && 'IntersectionObserver' in window) {
    const visible = new Set<Element>();
    const update = () => {
      const away = visible.size > 0;
      bar.toggleAttribute('data-away', away);
      bar.inert = away || Boolean(menu?.hasAttribute('data-open'));
    };

    if (menu) new MutationObserver(update).observe(menu, { attributes: true, attributeFilter: ['data-open'] });

    bar.hidden = false;

    const track = (entries: IntersectionObserverEntry[]) => {
      for (const entry of entries) {
        if (entry.isIntersecting) visible.add(entry.target);
        else visible.delete(entry.target);
      }
      update();
    };

    // The calendar counts once it reaches the usable viewport, between the sticky header on top
    // and the bar itself at the bottom. Both heights change with width, rotation and text size, so
    // the observer is rebuilt with fresh margins whenever one of them does. The footer counts as
    // soon as it touches the viewport.
    let calendarObserver: IntersectionObserver | undefined;
    let insets = '';
    const observeCalendars = () => {
      const margins = `-${header?.offsetHeight ?? 0}px 0px -${bar.offsetHeight}px 0px`;
      if (margins === insets) return;
      insets = margins;
      calendarObserver?.disconnect();
      calendars.forEach((el) => visible.delete(el));
      calendarObserver = new IntersectionObserver(track, { rootMargin: margins });
      calendars.forEach((el) => calendarObserver!.observe(el));
    };
    observeCalendars();
    const footerObserver = new IntersectionObserver(track);
    footers.forEach((el) => footerObserver.observe(el));
    document.documentElement.classList.add('has-sticky-cta');

    const sizes = new ResizeObserver(() => {
      document.documentElement.style.setProperty('--sticky-cta-height', `${bar.offsetHeight}px`);
      observeCalendars();
    });
    sizes.observe(bar);
    if (header) sizes.observe(header);

    // Browsers do not all honour scroll-padding when focus moves, so a focused element that ends up
    // behind the visible bar is scrolled up until it clears the bar's top edge.
    document.addEventListener('focusin', (event) => {
      const target = event.target as HTMLElement;
      // The bar is inert while away or while the menu is open; then it covers nothing.
      const clear = () => bar.inert || bar.offsetHeight === 0 || bar.contains(target);
      if (clear()) return;
      requestAnimationFrame(() => {
        if (clear()) return;
        const overlap = target.getBoundingClientRect().bottom - bar.getBoundingClientRect().top + 8;
        if (overlap > 0) window.scrollBy({ top: overlap, behavior: 'instant' });
      });
    });
  }
</script>
