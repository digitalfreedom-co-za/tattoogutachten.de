---
// Header mark: the RW monogram cropped from the DGuSV badge, plus a typeset wordmark.
// The full badge (with its claim text) is shown in the trust strip, where it is readable.
import { Image } from 'astro:assets';
import badge from '../../assets/images/rw-gutachterabzeichen-dgusv-logo.png';
import { site } from '../../config/site';
import { url } from '../../lib/url';

interface Props {
  tone?: 'ink' | 'paper';
}

const { tone = 'ink' } = Astro.props;
---

<a
  href={url('/')}
  class="group/logo inline-flex items-center gap-3 rounded-xs"
  aria-label={`${site.name}, ${site.office}, zur Startseite`}
>
  <Image
    src={badge}
    alt=""
    width={44}
    height={44}
    fit="cover"
    position="left"
    densities={[1, 2, 3]}
    loading="eager"
    class="size-10 shrink-0 md:size-11"
  />
  <span class="flex flex-col leading-none">
    <span class:list={['font-serif text-[1.3125rem] tracking-tightish md:text-[1.4375rem]', tone === 'ink' ? 'text-ink' : 'text-paper']}>
      {site.name}
    </span>
    <span class:list={['label mt-1 hidden text-[0.625rem] tracking-[0.16em] whitespace-nowrap min-[420px]:block', tone === 'ink' ? 'text-graphite' : 'text-paper/60']}>
      {site.office}
    </span>
  </span>
</a>
