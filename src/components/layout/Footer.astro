---
// Site footer on ink: office address and direct contact, navigation, audience pages,
// legal links, DGuSV seal.
import Container from '../ui/Container.astro';
import Seal from '../ui/Seal.astro';
import Icon from '../ui/Icon.astro';
import { site, contact, credentials, mainNavFor, legalNavFor, primaryCtaFor } from '../../config/site';
import { audiencesFor } from '../../data';
import { url } from '../../lib/url';
import { privacySection } from '../../config/consent';
import { pageLocale, t, fill } from '../../i18n';

const year = new Date().getFullYear();
const locale = pageLocale(Astro.url);
const copy = t(locale).footer;
const labels = t(locale).contactLabels;
const mainNav = mainNavFor(locale);
const legalNav = legalNavFor(locale);
const primaryCta = primaryCtaFor(locale);
const audiences = audiencesFor(locale);
---

<footer class="bg-ink text-paper" data-inert-when-menu>
  <Container>
    <div class="border-t border-paper/25" aria-hidden="true"></div>
  </Container>
  <Container class="grid gap-12 pt-12 pb-10 md:grid-cols-12 md:gap-x-8 md:pt-16">
    <div class="md:col-span-12 lg:col-span-4">
      <p class="font-serif text-h3 tracking-tightish">{site.office}</p>
      <p class="mt-2 text-sm text-paper/60">{site.expert}, {t(locale).site.role}</p>
      <address class="mt-8 grid gap-2 text-[0.9375rem] not-italic">
        <p class="flex gap-3">
          <Icon name="pin" size={18} class="mt-0.5 shrink-0 text-brass-light" />
          <span>
            {contact.street}<br />
            {contact.postalCode} {contact.city}
            <span class="mt-1 block text-sm text-paper/60">{fill(copy.areaServed, { areaServed: t(locale).site.areaServed })}</span>
          </span>
        </p>
        <p>
          <a class="link-ink inline-flex min-h-11 min-w-11 items-center gap-3 hover:!text-brass-light" href={contact.phone.href}>
            <Icon name="phone" size={18} class="shrink-0 text-brass-light" />
            <span><span class="sr-only">{labels.phone} </span>{contact.phone.display}</span>
          </a>
        </p>
        <p>
          <a class="link-ink inline-flex min-h-11 min-w-11 items-center gap-3 hover:!text-brass-light" href={contact.email.href}>
            <Icon name="mail" size={18} class="shrink-0 text-brass-light" />
            <span class="break-all"><span class="sr-only">{labels.email} </span>{contact.email.display}</span>
          </a>
        </p>
      </address>
    </div>

    <nav aria-label={copy.label} class="grid gap-10 sm:grid-cols-2 sm:gap-x-8 md:col-span-7 lg:col-span-5">
      <div>
        <p class="label text-paper/50">{copy.pages}</p>
        <ul class="mt-3 grid text-[0.9375rem]">
          {
            mainNav.map((item) => (
              <li>
                <a class="link-ink inline-flex min-h-11 min-w-11 items-center no-underline hover:!text-brass-light hover:underline" href={url(item.href)}>{item.label}</a>
              </li>
            ))
          }
          <li>
            <a class="link-ink inline-flex min-h-11 min-w-11 items-center no-underline hover:!text-brass-light hover:underline" href={url(primaryCta.href)}>{primaryCta.label}</a>
          </li>
        </ul>
      </div>
      <div>
        <p class="label text-paper/50">{copy.audiences}</p>
        <ul class="mt-3 grid text-[0.9375rem]">
          {
            audiences.map((audience) => (
              <li>
                <a class="link-ink inline-flex min-h-11 min-w-11 items-center no-underline hover:!text-brass-light hover:underline" href={url(audience.href)}>
                  {copy.audiencePrefix} {locale === 'en' ? audience.label.toLowerCase() : audience.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>

    <div class="flex gap-6 md:col-span-5 lg:col-span-3 lg:justify-end">
      <Seal width={104} class="w-20 self-start md:w-[104px]" />
      <div class="text-sm text-paper/60 md:max-w-[11rem]">
        <p class="label text-paper/50">{copy.certification}</p>
        <p class="mt-3">{fill(copy.certified, { associationShort: credentials.associationShort })}</p>
        <p class="numeral mt-3 text-paper/80">{fill(copy.registerShort, { registerNumber: credentials.registerNumber })}</p>
      </div>
    </div>
  </Container>

  <Container>
    <div class="flex flex-col gap-2 border-t border-paper/15 py-4 text-sm text-paper/60 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} {site.office}</p>
      <ul class="flex flex-wrap gap-x-6">
        {
          legalNav.map((item) => (
            <li>
              <a class="link-ink inline-flex min-h-11 min-w-11 items-center hover:!text-brass-light" href={url(item.href)}>{item.label}</a>
            </li>
          ))
        }
        <li>
          <!-- Opens the consent settings (ConsentDialog); without JS it leads to the consent section. -->
          <a
            class="link-ink inline-flex min-h-11 min-w-11 items-center hover:!text-brass-light"
            href={url(privacySection(locale, 'consent'))}
            data-consent-open
            aria-haspopup="dialog">{copy.cookieSettings}</a
          >
        </li>
      </ul>
    </div>
  </Container>
</footer>
