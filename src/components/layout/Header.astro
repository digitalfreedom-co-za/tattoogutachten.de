---
// Site header: logo, main navigation, the page CTA (src/lib/primary-cta.ts: booking, or an enquiry
// on pages for lawyers and courts) as a visible text button on every breakpoint
// (compact below sm and between lg and xl, where the nav tightens too). Below lg, and whenever the
// desktop row does not fit (enlarged text), the navigation moves into a full screen panel behind a
// menu button (aria-expanded, Escape closes, focus is trapped and returned). Without JS the panel
// renders as a plain list under the header and the desktop row wraps instead of overflowing.
// aria-current="page" marks only the exact page; the parent section is a visual state (data-active).
// The audience pages form a "Für wen" group after the first nav item: a details disclosure in the
// desktop row (works without JS; the script closes it on Escape, outside click and focus loss) and a
// labelled group in the menu panel.
import Logo from './Logo.astro';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import { mainNav, contact } from '../../config/site';
import { audiences, audienceHref } from '../../data/audiences';
import { pageCta } from '../../lib/primary-cta';
import { url, withoutBase } from '../../lib/url';

const normalize = (path: string) => (path.endsWith('/') ? path : `${path}/`);
const currentPath = normalize(Astro.url.pathname);
const isPage = (href: string) => currentPath === normalize(url(href));
const isSection = (href: string) => currentPath.startsWith(normalize(url(href)));
const cta = pageCta(withoutBase(currentPath));
const audienceNav = audiences.map((audience) => ({ label: audience.navLabel, href: audienceHref(audience) }));
const audienceActive = audienceNav.some((item) => isPage(item.href));
const [firstNav, ...restNav] = mainNav;
---

<header id="site-header" class="relative z-40 border-b border-ink/15 bg-paper">
  <Container class="header-row flex min-h-(--header-height) items-center justify-between gap-2 min-[360px]:gap-4">
    <Logo />

    <nav aria-label="Hauptnavigation" class="desktop-nav hidden lg:block">
      <ul class="flex flex-wrap items-center gap-x-4 xl:gap-x-9">
        {
          [firstNav, null, ...restNav].map((item) =>
            item ? (
              <li>
                <a
                  href={url(item.href)}
                  aria-current={isPage(item.href) ? 'page' : undefined}
                  data-active={isSection(item.href) ? '' : undefined}
                  data-nav-href={item.href}
                  class="nav-link relative inline-flex min-h-11 min-w-11 items-center justify-center whitespace-nowrap py-2 text-[0.875rem] font-medium xl:text-[0.9375rem] text-ink-soft transition-colors hover:text-ink data-active:text-oxblood"
                >
                  {item.label}
                </a>
              </li>
            ) : (
              <li class="relative">
                <details class="nav-menu group/menu" data-nav-menu>
                  <summary
                    data-active={audienceActive ? '' : undefined}
                    data-nav-href="/#zielgruppen"
                    class="nav-link relative flex min-h-11 min-w-11 cursor-pointer list-none items-center gap-1.5 whitespace-nowrap py-2 text-[0.875rem] font-medium xl:text-[0.9375rem] text-ink-soft transition-colors hover:text-ink data-active:text-oxblood [&::-webkit-details-marker]:hidden"
                  >
                    Für wen
                    <Icon name="chevron" size={14} class="rotate-90 transition-transform duration-200 group-open/menu:-rotate-90 motion-reduce:transition-none" />
                  </summary>
                  <ul class="absolute top-full left-0 z-50 mt-3 grid w-72 border border-ink bg-paper py-2 shadow-[0_18px_40px_-20px_rgb(23_20_15/0.45)]">
                    {audienceNav.map((entry) => (
                      <li>
                        <a
                          href={url(entry.href)}
                          aria-current={isPage(entry.href) ? 'page' : undefined}
                          class="flex min-h-11 items-center px-5 py-2 text-[0.9375rem] text-ink transition-colors hover:bg-paper-deep hover:text-oxblood aria-[current=page]:text-oxblood"
                        >
                          {entry.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <div class="flex items-center gap-1.5 min-[360px]:gap-2">
      <Button href={cta.href} icon={cta.icon} class="header-cta whitespace-nowrap">{cta.label}</Button>
      <button
        type="button"
        class="menu-toggle hidden size-11 items-center justify-center bg-ink text-paper transition-colors hover:bg-oxblood"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Menü öffnen"
        title="Menü"
        data-label-open="Menü öffnen"
        data-label-close="Menü schließen"
      >
        <Icon name="menu" size={22} class="icon-open" />
        <Icon name="close" size={22} class="icon-close hidden" />
      </button>
    </div>
  </Container>

  <div id="mobile-nav" class="mobile-nav border-t border-ink/15 bg-paper lg:hidden">
    <Container class="flex min-h-full flex-col py-8">
      <nav aria-label="Hauptnavigation mobil">
        <ul class="border-t border-ink">
          {
            [firstNav, null, ...restNav].map((item, index) =>
              item ? (
                <li class="mobile-nav-item border-b border-rule" style={`--i:${index}`}>
                  <a
                    href={url(item.href)}
                    aria-current={isPage(item.href) ? 'page' : undefined}
                    data-active={isSection(item.href) ? '' : undefined}
                    data-nav-href={item.href}
                    class="flex items-baseline py-4 font-serif text-[1.75rem] leading-tight tracking-tightish text-ink transition-colors hover:text-oxblood data-active:text-oxblood"
                  >
                    {item.label}
                  </a>
                </li>
              ) : (
                <li class="mobile-nav-item border-b border-rule py-4" style={`--i:${index}`}>
                  <p id="mobile-nav-fuer-wen" class="label text-graphite">Für wen</p>
                  <ul class="mt-1 grid" aria-labelledby="mobile-nav-fuer-wen">
                    {audienceNav.map((entry) => (
                      <li>
                        <a
                          href={url(entry.href)}
                          aria-current={isPage(entry.href) ? 'page' : undefined}
                          class="flex min-h-11 items-center font-serif text-[1.25rem] leading-tight text-ink transition-colors hover:text-oxblood aria-[current=page]:text-oxblood"
                        >
                          {entry.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </li>
              ),
            )
          }
        </ul>
      </nav>
      <div class="mobile-nav-item mt-8 flex flex-col gap-6" style={`--i:${mainNav.length + 1}`}>
        <Button href={cta.href} icon={cta.icon} class="self-start">{cta.label}</Button>
        <ul class="grid text-sm text-graphite">
          <li>
            <a class="link-ink inline-flex min-h-11 items-center gap-3" href={contact.phone.href}>
              <Icon name="phone" size={18} class="shrink-0 text-oxblood" />
              <span><span class="sr-only">Telefon </span>{contact.phone.display}</span>
            </a>
          </li>
          <li>
            <a class="link-ink inline-flex min-h-11 items-center gap-3" href={contact.email.href}>
              <Icon name="mail" size={18} class="shrink-0 text-oxblood" />
              <span class="break-all"><span class="sr-only">E-Mail </span>{contact.email.display}</span>
            </a>
          </li>
        </ul>
      </div>
    </Container>
  </div>
</header>

<style>
  /* Desktop nav: hairline underline drawn from the left on hover, fixed under the current page. */
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.5rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .nav-link::after {
      transition: transform 350ms var(--ease-out-quint);
    }
  }

  .nav-link:hover::after,
  .nav-link[data-active]::after {
    transform: scaleX(1);
  }

  /* Without JS the row wraps when enlarged text no longer fits it, instead of widening the page. */
  .header-row {
    flex-wrap: wrap;
  }

  /* With JS the header sticks and the panel becomes an overlay toggled by the menu button.
     Without JS the header scrolls away, so the static panel never covers the page. */
  :global(.js) #site-header {
    position: sticky;
    top: 0;
  }

  /* With JS the row keeps one line: the script switches to the menu button when it would overflow. */
  :global(.js) .header-row,
  :global(.js) .desktop-nav ul {
    flex-wrap: nowrap;
  }

  :global(.js) .menu-toggle {
    display: inline-flex;
  }

  :global(.js) .mobile-nav {
    position: fixed;
    inset: var(--header-height) 0 0 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    visibility: hidden;
    opacity: 0;
    transition:
      opacity 250ms ease,
      visibility 0s linear 250ms;
  }

  :global(.js) .mobile-nav[data-open] {
    visibility: visible;
    opacity: 1;
    transition: opacity 250ms ease;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .mobile-nav-item {
      opacity: 0;
      transform: translateY(0.75rem);
      transition:
        opacity 500ms var(--ease-out-quint),
        transform 500ms var(--ease-out-quint);
    }

    :global(.js) .mobile-nav[data-open] .mobile-nav-item {
      opacity: 1;
      transform: none;
      transition-delay: calc(var(--i) * 45ms + 60ms);
    }
  }

  /* Compact booking button below sm and between lg and xl: tighter padding, no icon. The label stays. */
  @media (max-width: 39.99rem), (min-width: 64rem) and (max-width: 79.99rem) {
    #site-header :global(.header-cta) {
      gap: 0;
      padding-inline: 0.75rem;
      font-size: 0.8125rem;
    }

    #site-header :global(.header-cta svg) {
      display: none;
    }
  }

  /* From lg the desktop row shows, unless the script found it too wide (data-compact). */
  @media (min-width: 64rem) {
    :global(.js) #site-header:not([data-compact]) .menu-toggle,
    :global(.js) #site-header:not([data-compact]) .mobile-nav {
      display: none;
    }

    :global(.js) #site-header[data-compact] .desktop-nav {
      display: none;
    }

    :global(.js) #site-header[data-compact] .mobile-nav {
      display: block;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const panel = document.getElementById('mobile-nav');
  const header = document.getElementById('site-header');
  const desktop = window.matchMedia('(min-width: 64rem)');

  if (toggle && panel && header) {
    const focusables = () =>
      [toggle, ...panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')].filter(
        (el) => el.offsetParent !== null || el === toggle,
      );

    const setOpen = (open: boolean, returnFocus = true) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '');
      toggle.querySelector('.icon-open')?.classList.toggle('hidden', open);
      toggle.querySelector('.icon-close')?.classList.toggle('hidden', !open);
      panel.toggleAttribute('data-open', open);
      document.documentElement.style.overflow = open ? 'hidden' : '';
      // Background content leaves the focus order and the accessibility tree while open.
      document.querySelectorAll<HTMLElement>('[data-inert-when-menu]').forEach((el) => {
        el.inert = open;
      });

      if (open) {
        panel.querySelector<HTMLElement>('a[href]')?.focus();
      } else if (returnFocus) {
        toggle.focus();
      }
    };

    const isOpen = () => panel.hasAttribute('data-open');

    toggle.addEventListener('click', () => setOpen(!isOpen()));

    // Focus trap over the menu button and the panel while open; Escape works from anywhere.
    document.addEventListener('keydown', (event) => {
      if (!isOpen()) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        setOpen(false);
        return;
      }
      if (event.key !== 'Tab') return;
      const items = focusables();
      const first = items[0];
      const last = items[items.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    // Every header link closes the panel first: logo, booking button and the panel links alike.
    // tel: and mailto: keep the page open, so focus returns to the menu button. An anchor on the
    // current page is navigated explicitly once scrolling and interaction are restored, and focus
    // moves to its target, so the jump does not leave focus behind in the closed panel.
    header.addEventListener('click', (event) => {
      if (!isOpen() || event.defaultPrevented || event.button !== 0) return;
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const link = (event.target as HTMLElement).closest('a');
      if (!link || link.closest('#site-header') !== header) return;
      const href = link.getAttribute('href') ?? '';
      const staysOnPage = /^(tel|mailto):/.test(href);
      setOpen(false, staysOnPage);
      if (staysOnPage) return;

      const target = new URL(link.href, location.href);
      const samePage = target.origin === location.origin && target.pathname === location.pathname;
      const anchor = samePage && target.hash ? document.getElementById(decodeURIComponent(target.hash.slice(1))) : null;
      if (!anchor) return;
      event.preventDefault();
      if (location.hash !== target.hash) history.pushState(null, '', target.hash);
      anchor.scrollIntoView({ block: 'start' });
      if (!anchor.hasAttribute('tabindex')) anchor.setAttribute('tabindex', '-1');
      anchor.focus({ preventScroll: true });
    });

    const isShown = (el: HTMLElement) =>
      el.checkVisibility?.({ visibilityProperty: true }) ?? el.getClientRects().length > 0;

    // A focused header control that a mode switch hides hands focus to its visible counterpart:
    // into the desktop row the same link (or the booking button), into compact mode the menu button.
    // Focus elsewhere stays put.
    const handOverFocus = (focused: HTMLElement, compact: boolean) => {
      if (isShown(focused)) return;
      if (compact) {
        toggle.focus();
        return;
      }
      const navHref = focused.closest<HTMLElement>('[data-nav-href]')?.dataset.navHref;
      const target =
        (navHref && header.querySelector<HTMLElement>(`.desktop-nav [data-nav-href="${navHref}"]`)) ||
        header.querySelector<HTMLElement>('.header-cta');
      target?.focus();
    };

    // Compact mode below lg, and from lg whenever the desktop row overflows its container, e.g.
    // with enlarged text. The check renders the desktop row for one synchronous measurement.
    const row = header.querySelector<HTMLElement>('.header-row');
    const updateCompact = () => {
      if (!row) return;
      const active = document.activeElement;
      const focused = active instanceof HTMLElement && header.contains(active) ? active : null;
      let compact = !desktop.matches;
      if (!compact) {
        header.removeAttribute('data-compact');
        compact = row.scrollWidth > row.clientWidth;
      }
      header.toggleAttribute('data-compact', compact);
      if (!compact && isOpen()) setOpen(false, false);
      if (focused) handOverFocus(focused, compact);
    };

    if (row) {
      // The row height is set in rem, so a changed root text size also triggers the observer.
      new ResizeObserver(updateCompact).observe(row);
      document.fonts?.ready.then(updateCompact);
    }
    desktop.addEventListener('change', updateCompact);
    updateCompact();

    // "Für wen" disclosure in the desktop row: one click or Enter opens it; Escape, a click elsewhere
    // or focus moving out of it closes it again.
    const menus = Array.from(header.querySelectorAll<HTMLDetailsElement>('[data-nav-menu]'));
    document.addEventListener('click', (event) => {
      menus.forEach((menu) => {
        if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
      });
    });
    menus.forEach((menu) => {
      menu.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || !menu.open) return;
        menu.open = false;
        menu.querySelector('summary')?.focus();
      });
      menu.addEventListener('focusout', (event) => {
        const next = event.relatedTarget as Node | null;
        if (next && !menu.contains(next)) menu.open = false;
      });
    });

    document.documentElement.classList.add('nav-ready');
  }
</script>
