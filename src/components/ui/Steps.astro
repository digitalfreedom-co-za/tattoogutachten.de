---
// Process timeline. Each step: what happens, and optionally what the client prepares.
export interface Step {
  title: string;
  text: string;
  prepare?: string;
  duration?: string;
}

interface Props {
  steps: Step[];
  prepareLabel?: string;
  class?: string;
}

const { steps, prepareLabel = 'Sie bereiten vor', class: className } = Astro.props;
---

<ol class:list={['relative', className]} data-reveal-group>
  {
    steps.map((step, index) => (
      <li class="relative grid grid-cols-[2.25rem_1fr] gap-x-4 pb-12 last:pb-0 md:grid-cols-[6rem_1fr] md:gap-x-8 lg:grid-cols-[6rem_1fr_16rem]" data-reveal>
        {index < steps.length - 1 && (
          <span class="absolute top-11 bottom-1 left-[1.125rem] w-px bg-rule md:top-13 md:left-[1.375rem]" aria-hidden="true" />
        )}
        <span class="numeral flex size-9 items-center justify-center rounded-full border border-ink bg-paper text-base md:size-11 md:text-lg" aria-hidden="true">
          {String(index + 1).padStart(2, '0')}
        </span>
        <div class="pt-1 md:pt-2">
          <h3 class="text-h4">
            <span class="sr-only">Schritt {index + 1}: </span>
            {step.title}
          </h3>
          {step.duration && <p class="label mt-2 text-oxblood">{step.duration}</p>}
          <p class="mt-3 max-w-[34rem] text-graphite">{step.text}</p>
        </div>
        {step.prepare && (
          <aside class="col-start-2 mt-5 border-l border-brass pl-4 text-sm lg:col-start-3 lg:mt-2">
            <p class="label text-graphite">{prepareLabel}</p>
            <p class="mt-2 font-serif text-base italic text-ink-soft">{step.prepare}</p>
          </aside>
        )}
      </li>
    ))
  }
</ol>
