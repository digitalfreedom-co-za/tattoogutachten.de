---
// Process timeline. Each step: what happens, and optionally what the client prepares.
// The detailed mode (process page) replaces the short text with the long one plus a list.
import Icon from './Icon.astro';

export interface StepDetail {
  text: string;
  itemsLabel?: string;
  items?: string[];
  note?: string;
}

export interface Step {
  title: string;
  text: string;
  prepare?: string;
  duration?: string;
  detail?: StepDetail;
}

interface Props {
  steps: Step[];
  prepareLabel?: string;
  detailed?: boolean;
  class?: string;
}

const { steps, prepareLabel = 'Sie bereiten vor', detailed = false, class: className } = Astro.props;
---

<ol class:list={['relative', className]} data-reveal-group>
  {
    steps.map((step, index) => (
      <li class="relative grid grid-cols-[2.25rem_1fr] gap-x-4 pb-12 last:pb-0 md:grid-cols-[6rem_1fr] md:gap-x-8 lg:grid-cols-[6rem_1fr_16rem]" data-reveal>
        {index < steps.length - 1 && (
          <span class="absolute top-11 bottom-1 left-[1.125rem] w-px bg-rule md:top-13 md:left-[1.375rem]" aria-hidden="true" />
        )}
        <span class="numeral flex size-9 items-center justify-center rounded-full border border-ink bg-paper text-base md:size-11 md:text-lg" aria-hidden="true">
          {String(index + 1).padStart(2, '0')}
        </span>
        <div class="pt-1 md:pt-2">
          <h3 class="text-h4">
            <span class="sr-only">Schritt {index + 1}: </span>
            {step.title}
          </h3>
          {step.duration && <p class="label mt-2 text-oxblood">{step.duration}</p>}
          <p class="mt-3 max-w-[34rem] text-graphite">{detailed && step.detail ? step.detail.text : step.text}</p>
          {detailed && step.detail?.items && step.detail.items.length > 0 && (
            <div class="mt-5 max-w-[34rem]">
              {step.detail.itemsLabel && <p class="label text-graphite">{step.detail.itemsLabel}</p>}
              <ul class="mt-3 grid gap-2">
                {step.detail.items.map((item) => (
                  <li class="grid grid-cols-[1rem_1fr] gap-3">
                    <Icon name="check" size={16} class="mt-1 text-oxblood" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {detailed && step.detail?.note && (
            <p class="mt-5 max-w-[34rem] border-l border-rule pl-4 text-sm text-graphite">{step.detail.note}</p>
          )}
        </div>
        {step.prepare && (
          <aside class="col-start-2 mt-5 border-l border-brass pl-4 text-sm lg:col-start-3 lg:mt-2">
            <p class="label text-graphite">{prepareLabel}</p>
            <p class="mt-2 font-serif text-base italic text-ink-soft">{step.prepare}</p>
          </aside>
        )}
      </li>
    ))
  }
</ol>
