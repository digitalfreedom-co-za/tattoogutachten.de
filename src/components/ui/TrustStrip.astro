---
// Credentials at a glance. The principal qualifications lead: certification (with the register number
// as its secondary detail), experience and the court appointment, which keeps "in einem
// Gerichtsverfahren" directly under the court. Membership, area served and independence follow as a
// quieter second row; the seal and the RW badge sit beside them. Values come from src/config/site.ts.
import { Image } from 'astro:assets';
import badge from '../../assets/images/rw-gutachterabzeichen-dgusv-logo.png';
import Seal from './Seal.astro';
import Container from './Container.astro';
import { credentials } from '../../config/site';
import { pageLocale, t, fill } from '../../i18n';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

interface Fact {
  label: string;
  value: string;
  note?: string;
  detail?: string;
}

const copy = t(pageLocale(Astro.url)).trust;

const principal: Fact[] = [
  {
    label: copy.certifiedBy,
    value: credentials.associationShort,
    note: credentials.association,
    detail: fill(copy.register, { registerNumber: credentials.registerNumber }),
  },
  { label: copy.experience, value: fill(copy.experienceValue, { years: credentials.yearsInTrade }), note: copy.experienceNote },
  { label: copy.appointed, value: copy.appointedValue, note: copy.appointedNote },
];

const secondary: Fact[] = [
  { label: copy.member, value: credentials.membership },
  { label: copy.area, value: copy.areaValue, note: copy.areaNote },
  { label: copy.independent, value: copy.independentValue, note: copy.independentNote },
];
---

<section aria-label={copy.label} class:list={['border-y border-ink bg-paper-deep', className]}>
  <Container class="grid gap-8 py-8 md:py-10 xl:grid-cols-[auto_minmax(0,1fr)] xl:items-start xl:gap-12">
    <div class="flex flex-wrap items-center gap-5" data-reveal>
      <Seal width={84} class="w-16 md:w-[84px]" />
      <Image src={badge} alt={copy.badgeAlt} width={210} densities={[1, 2]} class="h-auto w-44 max-w-full md:w-[210px]" />
    </div>
    <div class="grid gap-6">
      <ul class="grid gap-6 md:grid-cols-3 md:gap-x-8" data-reveal-group>
        {
          principal.map((fact) => (
            <li class="min-w-0 border-l-2 border-oxblood pl-4 hyphens-auto break-words" data-reveal>
              <p class="label text-graphite">{fact.label}</p>
              <p class="mt-2 font-serif text-h4 text-ink">{fact.value}</p>
              {fact.note && <p class="text-sm leading-snug text-ink-soft">{fact.note}</p>}
              {fact.detail && <p class="numeral mt-1.5 text-sm text-graphite">{fact.detail}</p>}
            </li>
          ))
        }
      </ul>
      <ul class="grid gap-4 border-t border-rule pt-5 min-[420px]:grid-cols-2 md:grid-cols-3 md:gap-x-8" data-reveal-group>
        {
          secondary.map((fact) => (
            <li class="min-w-0 border-l border-rule pl-4 hyphens-auto break-words" data-reveal>
              <p class="label text-graphite">{fact.label}</p>
              <p class="mt-1 text-ink">
                <span class="font-serif text-lg leading-tight">{fact.value}</span>
                {fact.note && <span class="text-sm text-graphite"> {fact.note}</span>}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</section>
