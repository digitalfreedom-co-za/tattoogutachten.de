---
// Small uppercase label above a heading, e.g. "Leistungen", led by a short accent rule.
interface Props {
  tone?: 'ink' | 'paper';
  class?: string;
}

const { tone = 'ink', class: className } = Astro.props;
---

<p
  class:list={[
    'label flex items-center gap-3',
    tone === 'ink' ? 'text-graphite' : 'text-paper/70',
    className,
  ]}
>
  <span class:list={['h-px w-6', tone === 'ink' ? 'bg-oxblood' : 'bg-brass-light']} aria-hidden="true" />
  <span><slot /></span>
</p>
