---
// Page section in report layout: a narrow margin column (label, margin note)
// next to a wide content column. On small screens the margin column stacks on top.
// density: chapter for the principal parts of a page, support for short supporting explanations
// (less padding, smaller title, tighter gap to the content). axis: the content starts under the title
// instead of at the container edge; leave it off for layouts that span the grid on purpose
// (card grids, comparison tables, image and text splits).
import Container from './Container.astro';
import Eyebrow from './Eyebrow.astro';
import { withDisplayBreaks } from '../../lib/display-breaks';

interface Props {
  id?: string;
  label?: string;
  title?: string;
  intro?: string;
  tone?: 'paper' | 'deep' | 'ink';
  density?: 'chapter' | 'support';
  axis?: boolean;
  class?: string;
  /** Marks a booking section: the mobile booking bar steps aside while it is on screen. */
  'data-booking-section'?: boolean;
}

const {
  id,
  label,
  title,
  intro,
  tone = 'paper',
  density = 'chapter',
  axis = false,
  class: className,
  'data-booking-section': bookingSection,
} = Astro.props;
const support = density === 'support';
const headingId = id && title ? `${id}-titel` : undefined;
const hasHeader = Boolean(label || title || intro || Astro.slots.has('note'));

const toneClass = {
  paper: 'bg-paper text-ink',
  deep: 'bg-paper-deep text-ink',
  ink: 'bg-ink text-paper',
}[tone];
---

<section
  id={id}
  aria-labelledby={headingId}
  class:list={[support ? 'py-section-support' : 'py-section', toneClass, className]}
  data-booking-section={bookingSection || undefined}
>
  <Container>
    {
      hasHeader && (
        <header class="grid gap-6 md:grid-cols-12 md:gap-x-8">
          <div class="min-w-0 md:col-span-3">
            <div
              class:list={['hairline mb-4 md:mb-5', tone === 'ink' && 'bg-paper/20']}
              data-reveal="rule"
              aria-hidden="true"
            />
            {label && (
              <Eyebrow tone={tone === 'ink' ? 'paper' : 'ink'}>
                {label}
              </Eyebrow>
            )}
            {Astro.slots.has('note') && (
              <div
                class:list={[
                  'mt-4 max-w-[22rem] text-sm italic',
                  tone === 'ink' ? 'text-paper/60' : 'text-graphite',
                ]}
                style="font-family: var(--font-serif)"
              >
                <slot name="note" />
              </div>
            )}
          </div>
          {(title || intro) && (
            <div class="min-w-0 md:col-span-9 lg:col-span-8">
              {title && (
                <h2 id={headingId} class:list={[support ? 'text-h3' : 'text-h2 tracking-display']}>
                  {withDisplayBreaks(title)}
                </h2>
              )}
              {intro && (
                <p
                  class:list={[
                    'max-w-[38rem]',
                    support ? 'mt-3' : 'mt-5 text-lead',
                    tone === 'ink' ? 'text-paper/75' : 'text-graphite',
                  ]}
                  data-reveal
                >
                  {intro}
                </p>
              )}
            </div>
          )}
        </header>
      )
    }
    <div class:list={[hasHeader && (support ? 'mt-6 md:mt-8' : 'mt-12 md:mt-16'), axis && 'md:grid md:grid-cols-12 md:gap-x-8']}>
      {axis ? <div class="axis min-w-0"><slot /></div> : <slot />}
    </div>
  </Container>
</section>
