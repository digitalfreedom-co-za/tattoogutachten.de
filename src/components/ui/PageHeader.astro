---
// Title block of a subpage, set like the cover of a report: breadcrumbs, a margin column with
// label and review date, the h1 with an answer first lead. The default slot takes actions,
// the meta slot extra lines in the margin column (e.g. author and reading time).
// Below md the label stays above the headline, while review date and meta follow the title block
// as a wrapping row, so the subject comes before the bibliographic detail.
// data-primary-action holds the mobile booking bar back (StickyCta): on the actions when there are
// any, otherwise on the whole title block, so the bar never covers the opening of a page.
import Container from './Container.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Eyebrow from './Eyebrow.astro';
import type { NavItem } from '../../config/site';
import { withDisplayBreaks } from '../../lib/display-breaks';

interface Props {
  heading: string;
  lead?: string;
  label: string;
  breadcrumbs: NavItem[];
  /** ISO date of the last factual review, shown as Stand. */
  updated?: string;
  class?: string;
}

const { heading, lead, label, breadcrumbs, updated, class: className } = Astro.props;
const hasMeta = Astro.slots.has('meta');
const hasActions = Astro.slots.has('default');
const updatedText = updated
  ? new Intl.DateTimeFormat('de-DE', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(updated))
  : undefined;
---

<Container class:list={['pt-10 pb-12 md:pt-14 md:pb-16', className]}>
  <Breadcrumbs items={breadcrumbs} />
  <div
    class="mt-10 grid gap-6 md:mt-16 md:grid-cols-12 md:grid-rows-[auto_1fr] md:gap-x-8 md:gap-y-0"
    data-primary-action={hasActions ? undefined : ''}
  >
    <div class="min-w-0 md:col-span-3">
      <div class="hairline mb-4" data-reveal="rule" aria-hidden="true"></div>
      <Eyebrow>{label}</Eyebrow>
    </div>
    <header class="min-w-0 md:col-span-9 md:row-span-2 md:row-start-1 lg:col-span-8">
      <h1 class="text-h1 tracking-display">{withDisplayBreaks(heading)}</h1>
      {lead && <p class="mt-6 max-w-[38rem] text-lead text-graphite">{lead}</p>}
      {hasActions && <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-5" data-primary-action><slot /></div>}
    </header>
    {
      (updatedText || hasMeta) && (
        <div class="flex min-w-0 flex-wrap items-baseline gap-x-5 gap-y-1 border-t border-rule pt-3 text-sm text-graphite md:col-span-3 md:col-start-1 md:row-start-2 md:block md:border-t-0 md:pt-0">
          {updatedText && <p class="md:mt-3">Stand: <time datetime={updated}>{updatedText}</time></p>}
          {hasMeta && <div class="md:mt-3"><slot name="meta" /></div>}
        </div>
      )
    }
  </div>
</Container>
