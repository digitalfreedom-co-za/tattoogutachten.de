---
// Restrained next step right after an article's conclusion, before any further reading: one sentence
// for the reader's situation, the booking link (telephone first while the calendar is the preview demo)
// and the telephone number. Set apart by a hairline, not a coloured box.
import Button from './Button.astro';
import Icon from './Icon.astro';
import { contact } from '../../config/site';
import { CAL_IS_DEMO } from '../../config/booking';
import { pageLocale, t, routes } from '../../i18n';

interface Props {
  text: string;
  class?: string;
}

const { text, class: className } = Astro.props;
const locale = pageLocale(Astro.url);
const labels = t(locale).contactLabels;
---

<aside class:list={['not-prose border-t border-ink pt-6', className]} aria-labelledby="next-step">
  <p id="next-step" class="label text-oxblood">{t(locale).nextStep.label}</p>
  <p class="mt-3 font-serif text-h4 text-ink">{text}</p>
  <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-3">
    {
      CAL_IS_DEMO ? (
        <>
          <Button href={contact.phone.href} icon="phone">
            <span class="sr-only">{labels.call} </span>{contact.phone.display}
          </Button>
          <a class="link-ink inline-flex min-h-11 items-center font-semibold" href={contact.email.href}>{labels.writeEmail}</a>
        </>
      ) : (
        <>
          <Button href={routes.booking[locale]} icon="calendar">{t(locale).nextStep.book}</Button>
          <a class="link-ink inline-flex min-h-11 items-center gap-3 font-semibold" href={contact.phone.href}>
            <Icon name="phone" size={18} class="shrink-0 text-oxblood" />
            <span><span class="sr-only">{labels.phone} </span>{contact.phone.display}</span>
          </a>
        </>
      )
    }
  </div>
</aside>
