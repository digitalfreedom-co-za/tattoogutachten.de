---
// Breadcrumb trail. The last item is the current page and is not linked.
import { url } from '../../lib/url';
import type { NavItem } from '../../config/site';
import { pageLocale, t, routes } from '../../i18n';

interface Props {
  items: NavItem[];
  class?: string;
}

const { items, class: className } = Astro.props;
const locale = pageLocale(Astro.url);
const trail: NavItem[] = [{ label: t(locale).nav.home, href: routes.home[locale] }, ...items];
---

<nav aria-label={t(locale).nav.breadcrumbs} class:list={['label text-graphite', className]}>
  <ol class="flex flex-wrap items-center gap-x-3">
    {
      trail.map((item, index) => {
        const isLast = index === trail.length - 1;
        return (
          <li class="flex items-center gap-3">
            {isLast ? (
              <span aria-current="page" class="inline-flex min-h-11 items-center text-ink">{item.label}</span>
            ) : (
              <>
                <a class="link-ink inline-flex min-h-11 items-center no-underline hover:underline" href={url(item.href)}>{item.label}</a>
                <span class="h-px w-4 bg-stone" aria-hidden="true" />
              </>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
