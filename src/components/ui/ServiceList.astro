---
// Service index in the style of a report's table of contents: topic label, title and
// answer first summary per row, the whole row links to the service page. No numbering.
// The rows use the section grid: label in the three column margin, title under the section title.
// grouped: two parts with their own heading, subject first, then commissioning route and occasion.
import Icon from './Icon.astro';
import { url } from '../../lib/url';
import { type Service, serviceHref, serviceGroups } from '../../data/services';

interface Props {
  services: Service[];
  /** Heading level of the service titles inside the surrounding outline. */
  headingLevel?: 'h3' | 'h4';
  grouped?: boolean;
  class?: string;
}

const { services, headingLevel = 'h3', grouped = false, class: className } = Astro.props;
const Heading = grouped ? 'h4' : headingLevel;
const parts = grouped
  ? serviceGroups
      .map((group) => ({ group, items: services.filter((service) => service.group === group.id) }))
      .filter((part) => part.items.length > 0)
  : [{ group: undefined, items: services }];
---

<div class={className}>
  {
    parts.map(({ group, items }) => (
      <div class:list={[group && 'mt-14 first:mt-0']}>
        {group && (
          <div class="mb-6 md:grid md:grid-cols-12 md:gap-x-8" data-reveal>
            <div class="axis">
              <h3 class="label text-ink">{group.title}</h3>
              <p class="mt-2 max-w-[40rem] text-sm text-graphite">{group.text}</p>
            </div>
          </div>
        )}
        <ul class="border-t border-ink" data-reveal-group>
          {
            items.map((service) => (
              <li class="group/row relative border-b border-rule transition-colors duration-300 hover:bg-paper-deep/60 has-[a:focus-visible]:bg-paper-deep/60" data-reveal>
                <div class="grid gap-3 py-6 md:grid-cols-12 md:items-baseline md:gap-x-8 md:py-8 md:pr-2">
                  <p class="label text-oxblood md:col-span-3">{service.kicker}</p>
                  <div class="min-w-0 md:col-span-8">
                    <Heading class="text-h3">
                      <a
                        href={url(serviceHref(service))}
                        class="after:absolute after:inset-0 focus-visible:outline-none focus-visible:after:outline-2 focus-visible:after:outline-offset-2 focus-visible:after:outline-signal"
                      >
                        {service.title}
                      </a>
                    </Heading>
                    <p class="mt-3 max-w-[40rem] text-graphite">{service.summary}</p>
                  </div>
                  <Icon
                    name="arrow"
                    size={22}
                    class="hidden text-ink transition-transform duration-300 group-hover/row:translate-x-1 group-hover/row:text-oxblood group-has-[a:focus-visible]/row:translate-x-1 group-has-[a:focus-visible]/row:text-oxblood motion-reduce:transition-none md:block"
                  />
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    ))
  }
</div>
