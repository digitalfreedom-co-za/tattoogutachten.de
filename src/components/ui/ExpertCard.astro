---
// Who writes the report, as a supporting attribution next to service and audience content: a top rule
// instead of a frame, the head and shoulders portrait, name, the two principal facts and the link to the
// full credentials on the about page.
import { Image } from 'astro:assets';
import { url } from '../../lib/url';
import { site, credentials } from '../../config/site';
import { pageLocale, t, fill, routes, anchor } from '../../i18n';
import portrait from '../../assets/images/patrick-wolf-portrait-kopf-schulter.jpg';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const locale = pageLocale(Astro.url);
const copy = t(locale).expertCard;
---

<aside class:list={['border-t border-ink pt-5', className]} aria-label={copy.label} data-reveal>
  <div class="flex flex-wrap items-start gap-4">
    <Image
      src={portrait}
      alt={fill(copy.portraitAlt, { expert: site.expert })}
      width={72}
      height={90}
      densities={[1, 2]}
      fit="cover"
      position="top"
      class="h-[5.625rem] w-18 shrink-0 object-cover"
    />
    <div class="min-w-0 flex-1 basis-36 hyphens-auto break-words">
      <p class="label text-graphite">{copy.label}</p>
      <p class="mt-1.5 font-serif text-h4">{site.expert}</p>
      <ul class="mt-2 grid gap-1 text-sm text-graphite">
        <li>{fill(copy.certified, { associationShort: credentials.associationShort })}</li>
        <li>{fill(copy.experience, { years: credentials.yearsInTrade })}</li>
      </ul>
    </div>
  </div>
  <a class="link-ink mt-3 inline-flex min-h-11 items-center text-sm font-semibold" href={url(`${routes.about[locale]}#${anchor('qualifications', locale)}`)}>
    {fill(copy.link, { expert: site.expert })}
  </a>
</aside>
