---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  as?: 'div' | 'section' | 'header' | 'footer' | 'nav';
  width?: 'page' | 'prose';
}

const { as: Tag = 'div', width = 'page', class: className, ...rest } = Astro.props;
---

<Tag
  class:list={[
    // viewport-fit=cover lets backgrounds run under a notch in landscape; the content keeps clear of it.
    'mx-auto w-full pl-[max(var(--spacing-gutter),env(safe-area-inset-left))] pr-[max(var(--spacing-gutter),env(safe-area-inset-right))]',
    width === 'page' ? 'max-w-page' : 'max-w-[calc(var(--container-prose)+2*var(--spacing-gutter))]',
    className,
  ]}
  {...rest}
>
  <slot />
</Tag>
