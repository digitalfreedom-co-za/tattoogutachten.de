---
// Closing call to action on ink: serif statement left, the primary action and one compact alternative
// contact line right. The full address and contact directory stay in the footer, which follows below a
// rule. action="booking" leads with the calendar and offers the telephone; action="contact" leads with
// the telephone and offers the given link (calendar or email). Default: contact while the calendar is the
// preview demo. data-cta-band lets the mobile booking bar step aside while this band is on screen.
import Container from './Container.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
import MeasureRule from './MeasureRule.astro';
import { url } from '../../lib/url';
import { contact, primaryCtaFor } from '../../config/site';
import { pageLocale, t } from '../../i18n';
import { CAL_IS_DEMO } from '../../config/booking';

interface Props {
  title: string;
  text?: string;
  ctaLabel?: string;
  ctaHref?: string;
  action?: 'booking' | 'contact';
}

const locale = pageLocale(Astro.url);
const primaryCta = primaryCtaFor(locale);
const labels = t(locale).contactLabels;
const {
  title,
  text,
  ctaLabel = primaryCta.label,
  ctaHref = primaryCta.href,
  action = CAL_IS_DEMO ? 'contact' : 'booking',
} = Astro.props;
---

<section class="relative overflow-hidden bg-ink pt-section pb-16 text-paper md:pb-20" aria-label={t(locale).cta.contactBand} data-cta-band>
  <MeasureRule class="absolute top-0 left-0 w-full text-paper/30" />
  <Container class="grid gap-10 md:grid-cols-12 md:gap-x-8">
    <div class="md:col-span-7">
      <h2 class="text-h2 tracking-display">{title}</h2>
      {text && <p class="mt-6 max-w-[34rem] text-lead text-paper/75" data-reveal>{text}</p>}
    </div>
    <div class="flex flex-col gap-5 md:col-span-4 md:col-start-9 md:justify-end">
      {
        action === 'booking' ? (
          <>
            <Button href={ctaHref} variant="inverse" icon="calendar" class="self-start">{ctaLabel}</Button>
            <p class="text-sm">
              <a class="link-ink inline-flex min-h-11 items-center gap-2 font-semibold hover:!text-brass-light" href={contact.phone.href}>
                <Icon name="phone" size={16} class="shrink-0 text-brass-light" />
                <span><span class="sr-only">{labels.phone} </span>{contact.phone.display}</span>
              </a>
            </p>
          </>
        ) : (
          <>
            <Button href={contact.phone.href} variant="inverse" icon="phone" class="self-start">
              <span class="sr-only">{labels.call} </span>{contact.phone.display}
            </Button>
            <p class="text-sm">
              <a class="link-ink inline-flex min-h-11 items-center font-semibold break-all hover:!text-brass-light" href={ctaHref.startsWith('/') ? url(ctaHref) : ctaHref}>
                {ctaLabel}
              </a>
            </p>
          </>
        )
      }
    </div>
  </Container>
</section>
