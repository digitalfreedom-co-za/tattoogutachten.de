---
// Long form layout for the Ratgeber articles and legal pages: breadcrumbs, report style
// title block with an optional byline, prose column and a margin column for notes
// (stacks under the text on mobile and tablet). With asideFirst the margin column comes first in
// the document and stacks above the text below lg, e.g. a contents navigation that has to be met
// before the sections it leads to; on desktop it stays in the margin. The "after" slot follows the
// article, e.g. related content and the closing call to action.
import BaseLayout from './BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import type { NavItem } from '../config/site';
import type { SeoProps } from '../components/seo/SeoHead.astro';
import { url } from '../lib/url';
import { pageLocale, t, formatDate } from '../i18n';
import { readingTimeText } from '../lib/reading-time';

export interface Byline {
  author: string;
  authorHref: string;
  /** ISO date of first publication. */
  published: string;
  readingMinutes: number;
}

interface Props extends Omit<SeoProps, 'breadcrumbs'> {
  heading: string;
  lead?: string;
  label?: string;
  breadcrumbs: NavItem[];
  /** ISO date of the last factual review, shown as Stand. */
  updated?: string;
  byline?: Byline;
  /** Puts the margin column before the text below lg (contents navigation). */
  asideFirst?: boolean;
}

const locale = pageLocale(Astro.url);
const copy = t(locale).article;
const { heading, lead, label = t(locale).nav.guides, breadcrumbs, updated, byline, asideFirst = false, ...seo } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<BaseLayout {...seo} breadcrumbs={breadcrumbs}>
  <article>
    <PageHeader heading={heading} lead={lead} label={label} breadcrumbs={breadcrumbs} updated={updated}>
      {
        byline && (
          <dl slot="meta" class="flex flex-wrap gap-x-5 gap-y-1 md:grid md:gap-3 md:border-t md:border-rule md:pt-3">
            <div>
              <dt class="sr-only">{copy.author}</dt>
              <dd>
                {copy.by} <a class="link-ink font-semibold" rel="author" href={url(byline.authorHref)}>{byline.author}</a>
              </dd>
            </div>
            <div>
              <dt class="sr-only">{copy.published}</dt>
              <dd>
                {copy.publishedOn} <time datetime={byline.published}>{formatDate(byline.published, locale)}</time>
              </dd>
            </div>
            <div>
              <dt class="sr-only">{copy.readingTime}</dt>
              <dd>{readingTimeText(byline.readingMinutes, locale)}</dd>
            </div>
          </dl>
        )
      }
    </PageHeader>
    <Container class="grid gap-12 pb-section md:grid-cols-12 md:gap-x-8">
      {
        hasAside && asideFirst && (
          <aside class="min-w-0 border-t border-ink pt-5 text-sm text-graphite hyphens-auto break-words md:col-span-8 md:col-start-4 lg:col-span-3 lg:col-start-10 lg:row-start-1 lg:self-start lg:sticky lg:top-[calc(var(--header-height)+2rem)]">
            <slot name="aside" />
          </aside>
        )
      }
      <div class="prose prose-report min-w-0 md:col-span-8 md:col-start-4 lg:col-span-6 lg:col-start-4 lg:row-start-1">
        <slot />
      </div>
      {
        hasAside && !asideFirst && (
          <aside class="min-w-0 border-t border-ink pt-5 text-sm text-graphite hyphens-auto break-words md:col-span-8 md:col-start-4 lg:col-span-3 lg:col-start-10 lg:self-start lg:sticky lg:top-[calc(var(--header-height)+2rem)]">
            <slot name="aside" />
          </aside>
        )
      }
    </Container>
  </article>
  <slot name="after" />
</BaseLayout>
