---
// Long form layout for the Ratgeber articles and legal pages: breadcrumbs, report style
// title block with an optional byline, prose column and a margin column for notes
// (stacks under the text on mobile). The "after" slot follows the article, e.g. related
// content and the closing call to action.
import BaseLayout from './BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import type { NavItem } from '../config/site';
import { url } from '../lib/url';

export interface Byline {
  author: string;
  authorHref: string;
  /** ISO date of first publication. */
  published: string;
  readingMinutes: number;
}

interface Props {
  title: string;
  description: string;
  heading: string;
  lead?: string;
  label?: string;
  breadcrumbs: NavItem[];
  /** ISO date of the last factual review, shown as Stand. */
  updated?: string;
  byline?: Byline;
}

const { title, description, heading, lead, label = 'Ratgeber', breadcrumbs, updated, byline } = Astro.props;
const formatDate = (iso: string) =>
  new Intl.DateTimeFormat('de-DE', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(iso));
---

<BaseLayout title={title} description={description}>
  <slot name="head" slot="head" />
  <article>
    <PageHeader heading={heading} lead={lead} label={label} breadcrumbs={breadcrumbs} updated={updated}>
      {
        byline && (
          <dl slot="meta" class="grid gap-3 border-t border-rule pt-3">
            <div>
              <dt class="sr-only">Autor</dt>
              <dd>
                Von <a class="link-ink font-semibold" rel="author" href={url(byline.authorHref)}>{byline.author}</a>
              </dd>
            </div>
            <div>
              <dt class="sr-only">Veröffentlicht</dt>
              <dd>
                Veröffentlicht am <time datetime={byline.published}>{formatDate(byline.published)}</time>
              </dd>
            </div>
            <div>
              <dt class="sr-only">Lesezeit</dt>
              <dd>{byline.readingMinutes} {byline.readingMinutes === 1 ? 'Minute' : 'Minuten'} Lesezeit</dd>
            </div>
          </dl>
        )
      }
    </PageHeader>
    <Container class="grid gap-12 pb-section md:grid-cols-12 md:gap-x-8">
      <div class="prose prose-report md:col-span-8 md:col-start-4 lg:col-span-6 lg:col-start-4">
        <slot />
      </div>
      {
        Astro.slots.has('aside') && (
          <aside class="border-t border-ink pt-5 text-sm text-graphite md:col-span-8 md:col-start-4 lg:col-span-3 lg:col-start-10 lg:self-start lg:sticky lg:top-[calc(var(--header-height)+2rem)]">
            <slot name="aside" />
          </aside>
        )
      }
    </Container>
  </article>
  <slot name="after" />
</BaseLayout>
