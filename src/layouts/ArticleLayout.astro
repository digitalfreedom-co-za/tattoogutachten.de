---
// Long form layout for the Ratgeber articles and legal pages: breadcrumbs, report style
// title block, prose column and a margin column for notes (stacks under the text on mobile).
import BaseLayout from './BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import type { NavItem } from '../config/site';

interface Props {
  title: string;
  description: string;
  heading: string;
  lead?: string;
  label?: string;
  breadcrumbs: NavItem[];
  /** ISO date of the last factual review, shown as Stand. */
  updated?: string;
}

const { title, description, heading, lead, label = 'Ratgeber', breadcrumbs, updated } = Astro.props;
const updatedText = updated
  ? new Intl.DateTimeFormat('de-DE', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(updated))
  : undefined;
---

<BaseLayout title={title} description={description}>
  <slot name="head" slot="head" />
  <article>
    <Container class="pt-10 pb-12 md:pt-14 md:pb-16">
      <Breadcrumbs items={breadcrumbs} />
      <div class="mt-12 grid gap-8 md:mt-16 md:grid-cols-12 md:gap-x-8">
        <div class="md:col-span-3">
          <div class="hairline mb-4" data-reveal="rule" aria-hidden="true"></div>
          <Eyebrow>{label}</Eyebrow>
          {updatedText && <p class="mt-3 text-sm text-graphite">Stand: <time datetime={updated}>{updatedText}</time></p>}
        </div>
        <header class="md:col-span-9 lg:col-span-8">
          <h1 class="text-h1 tracking-display">{heading}</h1>
          {lead && <p class="mt-6 max-w-[38rem] text-lead text-graphite">{lead}</p>}
        </header>
      </div>
    </Container>
    <Container class="grid gap-12 pb-section md:grid-cols-12 md:gap-x-8">
      <div class="prose prose-report md:col-span-8 md:col-start-4 lg:col-span-6 lg:col-start-4">
        <slot />
      </div>
      {
        Astro.slots.has('aside') && (
          <aside class="border-t border-ink pt-5 text-sm text-graphite md:col-span-8 md:col-start-4 lg:col-span-3 lg:col-start-10 lg:self-start lg:sticky lg:top-[calc(var(--header-height)+2rem)]">
            <slot name="aside" />
          </aside>
        )
      }
    </Container>
  </article>
</BaseLayout>
